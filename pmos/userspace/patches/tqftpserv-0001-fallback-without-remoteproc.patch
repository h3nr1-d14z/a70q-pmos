diff --git a/translate.c b/translate.c
index 246b82d..6ebd8ca 100644
--- a/translate.c
+++ b/translate.c
@@ -51,6 +51,37 @@ static void read_fw_path_from_sysfs(char *outbuffer, size_t bufsize)
 	outbuffer[pathsize - 1] = '\0';
 }
 
+static int translate_readonly_dirs(const char *fw_sysfs_path, const char *file)
+{
+	const char *env = getenv("TQFTPSERV_FW_DIRS");
+	char path[PATH_MAX];
+	char *dirs, *dir, *save = NULL;
+	int fd;
+
+	if (fw_sysfs_path[0] &&
+	    snprintf(path, sizeof(path), "%s/%s", fw_sysfs_path, file) < (int)sizeof(path)) {
+		fd = open_maybe_compressed(path);
+		if (fd >= 0)
+			return fd;
+	}
+
+	if (!env || !*env)
+		return -1;
+	dirs = strdup(env);
+	if (!dirs)
+		return -1;
+	fd = -1;
+	for (dir = strtok_r(dirs, ":", &save); dir; dir = strtok_r(NULL, ":", &save)) {
+		if (snprintf(path, sizeof(path), "%s/%s", dir, file) >= (int)sizeof(path))
+			continue;
+		fd = open_maybe_compressed(path);
+		if (fd >= 0)
+			break;
+	}
+	free(dirs);
+	return fd;
+}
+
 /**
  * translate_readonly() - open "file" residing with remoteproc firmware
  * @file:	file requested, stripped of "/readonly/image/" prefix
@@ -80,12 +111,16 @@ static int translate_readonly(const char *file)
 	ssize_t n;
 	int fd = -1;
 
+	fw_sysfs_path[0] = '\0';
 	read_fw_path_from_sysfs(fw_sysfs_path, sizeof(fw_sysfs_path));
 
 	class_fd = open("/sys/class/remoteproc", O_RDONLY | O_DIRECTORY);
 	if (class_fd < 0) {
-		warn("failed to open remoteproc class");
-		return -1;
+		/*
+		 * Downstream (msm_subsys) kernels have no remoteproc class: look
+		 * in firmware_class.path and in TQFTPSERV_FW_DIRS (colon list).
+		 */
+		return translate_readonly_dirs(fw_sysfs_path, file);
 	}
 
 	class_dir = fdopendir(class_fd);
