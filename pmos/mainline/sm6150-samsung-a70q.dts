&{/soc@0/funnel@6042000} { status = "disabled"; };
&{/soc@0/funnel@6045000} { status = "disabled"; };
&{/soc@0/replicator@6046000} { status = "disabled"; };
&{/soc@0/tmc@6047000} { status = "disabled"; };
&{/soc@0/tmc@6048000} { status = "disabled"; };
&{/soc@0/cti@683b000} { status = "disabled"; };
&{/soc@0/tpdm@684c000} { status = "disabled"; };
&{/soc@0/tpdm@6850000} { status = "disabled"; };
&{/soc@0/tpdm@6860000} { status = "disabled"; };
&{/soc@0/funnel@6861000} { status = "disabled"; };
&{/soc@0/cti@6867000} { status = "disabled"; };
&{/soc@0/tpdm@69c0000} { status = "disabled"; };
&{/soc@0/funnel@69c3000} { status = "disabled"; };
&{/soc@0/cti@6a02000} { status = "disabled"; };
&{/soc@0/cti@6a03000} { status = "disabled"; };
&{/soc@0/cti@6a10000} { status = "disabled"; };
