/*
 * Interconnect providers: even without QoS the boot stopped at "soc@0interconnect@9680000 /
 * qnoc-qcs615" (gem_noc): registering a provider makes icc-rpmh vote maximum bandwidth on its BCMs
 * via RPMh until sync_state (for gem_noc: shared bus / DDR). Milestone 1 needs no interconnect (the
 * bootloader's votes stay), so all providers are disabled for now.
 */
&camnoc_virt { status = "disabled"; };
&mc_virt { status = "disabled"; };
&config_noc { status = "disabled"; };
&system_noc { status = "disabled"; };
&aggre1_noc { status = "disabled"; };
&mmss_noc { status = "disabled"; };
&dc_noc { status = "disabled"; };
&gem_noc { status = "disabled"; };
