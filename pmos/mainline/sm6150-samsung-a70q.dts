&{/soc@0/cti@78f0000} { status = "disabled"; };
&{/soc@0/cti@7900000} { status = "disabled"; };
/* iommu@15000000 (apps_smmu) re-enabled for milestone 2: UFS DMA (stream 0x300) times out without it */




/*
 * Milestone 2: USB device mode (gadget) on the Type-C port, high speed only.
 * PHY supplies from the downstream qusb node (vdd = pm6150_l4, vdda18 = pm6150_l11,
 * vdda33 = pm6150_l17) and their voltage ranges.
 */
&apps_rsc {
	/*
	 * Without the PSCI CPU power domains (they made the firmware reset the phone) this waited
	 * forever for /psci/power-domain-cluster, holding back rpmhcc, GCC, regulators and USB.
	 * Without power-domains rpmh-rsc flushes its sleep/wake votes from CPU PM notifiers instead.
	 */
	/delete-property/ power-domains;

	regulators-0 {
		compatible = "qcom,pm6150-rpmh-regulators";
		qcom,pmic-id = "a";

		vreg_l4a: ldo4 {
			regulator-name = "vreg_l4a";
			regulator-min-microvolt = <875000>;
			regulator-max-microvolt = <975000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		/* panel vddio (downstream dsi_panel_pwr_supply "vddio") */
		vreg_l13a: ldo13 {
			regulator-name = "vreg_l13a";
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1900000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
			regulator-boot-on;
		};

		vreg_l11a: ldo11 {
			regulator-name = "vreg_l11a";
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1890000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_l12a: ldo12 {
			regulator-name = "vreg_l12a";
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1950000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		/* touchscreen avdd (downstream pm6150_l18, 3.0 V) */
		vreg_l18a: ldo18 {
			regulator-name = "vreg_l18a";
			regulator-min-microvolt = <3000000>;
			regulator-max-microvolt = <3000000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		/*
		 * WiFi (WCN3990) cx/mx, downstream pm6150_l9. Always on: ath10k only powers the chip
		 * after the WLAN firmware on the modem reports ready, but that firmware needs the chip
		 * powered to come up - on the first modem start after boot (L9A still off) it never
		 * does and the modem asserts 40 s later ("fatal error without message"). Downstream
		 * icnss powers the chip as soon as the modem is up.
		 */
		vreg_l9a: ldo9 {
			regulator-name = "vreg_l9a";
			regulator-min-microvolt = <400000>;
			regulator-max-microvolt = <728000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
			regulator-always-on;
		};

		/* rear camera focus actuator (downstream cam_vaf-supply = pm6150_l19) */
		vreg_l19a: ldo19 {
			regulator-name = "vreg_l19a";
			regulator-min-microvolt = <2696000>;
			regulator-max-microvolt = <3008000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		/* WCD937x vdd-rxtx / vdd-px (downstream cdc-vdd-ldo-rxtx, cdc-vddpx-1) */
		vreg_l10a: ldo10 {
			regulator-name = "vreg_l10a";
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1830000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		/* WCD937x vdd-buck (downstream cdc-vdd-buck) */
		vreg_l15a: ldo15 {
			regulator-name = "vreg_l15a";
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1900000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_l17a: ldo17 {
			regulator-name = "vreg_l17a";
			regulator-min-microvolt = <3000000>;
			regulator-max-microvolt = <3230000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};
	};
};

&apps_rsc {
	regulators-1 {
		compatible = "qcom,pm6150l-rpmh-regulators";
		qcom,pmic-id = "c";

		/* WCN3990 supplies (downstream icnss: 1.8-xo = l1, 1.3-rfa = l2, 3.3-ch0 = l10) */
		/* DSI controller analog rail (downstream vdda-1p2) */
		vreg_l3c: ldo3 {
			regulator-name = "vreg_l3c";
			regulator-min-microvolt = <1232000>;
			regulator-max-microvolt = <1260000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
			regulator-boot-on;
		};

		vreg_l1c: ldo1 {
			regulator-name = "vreg_l1c";
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1900000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
			/* WCN3990 (with BT): always on, see vreg_l9a */
			regulator-always-on;
		};

		vreg_l2c: ldo2 {
			regulator-name = "vreg_l2c";
			regulator-min-microvolt = <1304000>;
			regulator-max-microvolt = <1304000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
			/* WCN3990 (with BT): always on, see vreg_l9a */
			regulator-always-on;
		};

		/* microSD vqmmc (downstream sdhc_2 vdd-io, 1.8/2.95 V) */
		vreg_l6c: ldo6 {
			regulator-name = "vreg_l6c";
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <3100000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		/* microSD vmmc (downstream sdhc_2 vdd) */
		vreg_l9c: ldo9 {
			regulator-name = "vreg_l9c";
			/* 2.95 V is off the PMIC5 PLDO 8 mV grid */
			regulator-min-microvolt = <2952000>;
			regulator-max-microvolt = <2952000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		/* WCD937x mic bias supply (downstream cdc-vdd-mic-bias = pm6150l_bob) */
		vreg_bob: bob {
			regulator-name = "vreg_bob";
			regulator-min-microvolt = <3296000>;
			regulator-max-microvolt = <3960000>;
		};

		vreg_l10c: ldo10 {
			regulator-name = "vreg_l10c";
			regulator-min-microvolt = <3200000>;
			regulator-max-microvolt = <3312000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
			/* WCN3990 (with BT): always on, see vreg_l9a */
			regulator-always-on;
		};

		/* UFS vcc (downstream pm6150l_l11) */
		vreg_l11c: ldo11 {
			regulator-name = "vreg_l11c";
			regulator-min-microvolt = <2950000>;
			regulator-max-microvolt = <3312000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};
	};
};

/*
 * UFS (supplies from the downstream ufshc/ufsphy nodes: vcc = pm6150l_l11, vccq2 = pm6150_l12,
 * PHY = pm6150_l4 / pm6150_l11).
 */
&ufs_mem_hc {
	vcc-supply = <&vreg_l11c>;
	vcc-max-microamp = <600000>;
	vccq2-supply = <&vreg_l12a>;
	vccq2-max-microamp = <600000>;

	status = "okay";
};

&ufs_mem_phy {
	vdda-phy-supply = <&vreg_l4a>;
	vdda-pll-supply = <&vreg_l11a>;

	status = "okay";
};

&usb_1_hsphy {
	vdd-supply = <&vreg_l4a>;
	vdda-pll-supply = <&vreg_l11a>;
	vdda-phy-dpdm-supply = <&vreg_l17a>;

	status = "okay";
};

&usb_1 {
	phys = <&usb_1_hsphy>;
	phy-names = "usb2-phy";
	maximum-speed = "high-speed";
	/* no USB3 PHY: clock the PIPE domain from UTMI (otherwise ep0 commands time out) */
	qcom,select-utmi-as-pipe-clk;
	/* role from the PM6150 Type-C port controller (connector below) */
	dr_mode = "otg";
	usb-role-switch;

	status = "okay";

	port {
		usb_1_role_switch_in: endpoint {
			remote-endpoint = <&pm6150_hs_in>;
		};
	};
};

/*
 * Milestone 3: Adreno 612. Firmware from the pmOS rootfs (/lib/firmware: a630_sqe.fw, a612_rgmu.bin and
 * Samsung's signed zap shader a612_zap.mdt/.b0x).
 */
&gpu {
	status = "okay";
};

/*
 * This chip's GPU speed bin is capped at 745 MHz (downstream kgsl: 745/700/550/435/290 MHz).
 * At 845 MHz (CX turbo) the GPU does not run at all: CP registers read back 0 and CP_INIT
 * times out ("timeout waiting to drain ringbuffer 0 rptr/wptr = 0/C").
 */
&gpu_opp_table {
	/delete-node/ opp-845000000;
};

&gpu_zap_shader {
	/* device-signed zap (firmware partition: a612_zap.mdt/.b0x), linked into /lib/firmware/qcom */
	firmware-name = "qcom/a612_zap.mdt";
};

&gmu {
	status = "okay";
};

/*
 * GCC GDSCs sit on the RPMh CX rail: without this the GPUCC parents (GPLL0,
 * GCC_GPU_GPLL0_DIV_CLK_SRC) are never voted on and the GPU core clock stays dead (the CP
 * never fetched the ring). Upstream commit 5ad7eb6a944e; found by the violet (Redmi Note 7
 * Pro, SM6150) mainline port.
 */
&gcc {
	power-domains = <&rpmhpd RPMHPD_CX>;
};


/* PMIC peripherals: power key (pwrkey), volume down (RESIN), RTC; volume up = pm6150l GPIO 8 */
/*
 * Battery: no mainline driver for the PM6150 QG fuel gauge / SMB5 charger (the SMB5 charges with
 * its hardware defaults). a70q-battery reads the QG voltage/current samples and counts coulombs.
 */
&pm6150_lsid0 {
	battery {
		compatible = "samsung,a70q-battery";
	};
};

&pm6150_resin {
	linux,code = <KEY_VOLUMEDOWN>;
	status = "okay";
};

&pm6150_rtc {
	status = "okay";
};

&pm6150l_gpios {
	vol_up_n: vol-up-n-state {
		pins = "gpio8";
		function = "normal";
		input-enable;
		bias-pull-up;
	};
};

/ {
	gpio-keys {
		compatible = "gpio-keys";
		label = "gpio-keys";
		pinctrl-0 = <&vol_up_n>;
		pinctrl-names = "default";

		key-volume-up {
			label = "volume_up";
			gpios = <&pm6150l_gpios 8 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_VOLUMEUP>;
			debounce-interval = <15>;
			wakeup-source;
		};
	};
};

/* Touchscreen: Imagis IST4050 on QUP0 SE1 (downstream i2c@884000, address 0x50, irq GPIO 89, power GPIO 93) */
/* the SEs are in GPI mode (set by the firmware): geni-i2c needs the GPI DMA engine */
&gpi_dma0 {
	status = "okay";
};

&qupv3_id_0 {
	status = "okay";
};

&i2c1 {
	clock-frequency = <400000>;
	status = "okay";

	touchscreen@50 {
		compatible = "imagis,ist40xx";
		reg = <0x50>;
		interrupts-extended = <&tlmm 89 IRQ_TYPE_LEVEL_LOW>;
		power-gpios = <&tlmm 93 GPIO_ACTIVE_HIGH>;
		pinctrl-0 = <&ts_int>;
		pinctrl-names = "default";
		vdd-supply = <&vreg_l18a>;
		touchscreen-size-x = <1080>;
		touchscreen-size-y = <2400>;
	};
};

&tlmm {
	/* downstream tsp_int: no pull on the touchscreen interrupt line */
	ts_int: ts-int-state {
		pins = "gpio89";
		function = "gpio";
		bias-disable;
		input-enable;
	};
};

/*
 * Display: DPU -> DSI0 (4 lanes, command mode, TE on GPIO 90) -> S6E3FC2 AMS670TA01 AMOLED.
 * vddio is L13A. Values from the downstream ss_dsi_panel_S6E3FC2_AMS670TA01_FHD node.
 */
&mdss {
	status = "okay";
};

&mdss_dsi0 {
	vdda-supply = <&vreg_l3c>;
	pinctrl-0 = <&panel_te_active>;
	pinctrl-names = "default";

	status = "okay";

	panel@0 {
		compatible = "samsung,s6e3fc2-ams670ta01";
		reg = <0>;

		vddio-supply = <&vreg_l13a>;
		reset-gpios = <&tlmm 91 GPIO_ACTIVE_LOW>;
		/*
		 * No enable GPIO: the downstream platform-en-gpio (PM6150 GPIO 6) is left an input with
		 * pull-up by the downstream kernel, and driving it breaks the panel. (PM6150L GPIO 6 is the
		 * vibrator PWM output.)
		 */

		port {
			panel_in: endpoint {
				remote-endpoint = <&mdss_dsi0_out>;
			};
		};
	};
};

&mdss_dsi0_out {
	remote-endpoint = <&panel_in>;
	data-lanes = <0 1 2 3>;
};

&mdss_dsi0_phy {
	vcca-supply = <&vreg_l4a>;

	status = "okay";
};

&tlmm {
	panel_te_active: panel-te-active-state {
		pins = "gpio90";
		function = "mdp_vsync";
		drive-strength = <2>;
		bias-pull-down;
	};
};

/*
 * Modem (MPSS) and WiFi (WCN3990, firmware on the modem DSP). QCS615 has no modem, so these come
 * from sm8150.dtsi (same interrupt/mailbox numbers) and the downstream DT: smp2p smem 435/428,
 * IPC bit 14, IRQ SPI 451; glink SPI 449, IPC bit 12; PAS id 4; WLAN CE IRQs SPI 414-425, SID 0x1640.
 */
/ {
	smp2p-modem {
		compatible = "qcom,smp2p";
		qcom,smem = <435>, <428>;
		interrupts = <GIC_SPI 451 IRQ_TYPE_EDGE_RISING 0>;
		mboxes = <&apss_shared 14>;
		qcom,local-pid = <0>;
		qcom,remote-pid = <1>;

		modem_smp2p_out: master-kernel {
			qcom,entry-name = "master-kernel";
			#qcom,smem-state-cells = <1>;
		};

		modem_smp2p_in: slave-kernel {
			qcom,entry-name = "slave-kernel";
			interrupt-controller;
			#interrupt-cells = <2>;
		};

		/*
		 * IPA <-> modem handshake (downstream qcom,smp2p-ipa-1-out/in). Without the AP's IPA
		 * the modem asserts ("fatal error without message") 40 s after it comes up, as found
		 * by the violet-sm6150-mainline project.
		 */
		modem_smp2p_ipa_out: ipa-ap-to-modem {
			qcom,entry-name = "ipa";
			#qcom,smem-state-cells = <1>;
		};

		modem_smp2p_ipa_in: ipa-modem-to-ap {
			qcom,entry-name = "ipa";
			interrupt-controller;
			#interrupt-cells = <2>;
		};
	};
};

/* IPA v4.2 (downstream qcom,ipa-hw-ver = 0x10, as sc7180) */
&{/soc@0} {
	ipa: ipa@1e40000 {
		compatible = "qcom,sc7180-ipa";
		reg = <0x0 0x01e40000 0x0 0x7000>,
		      <0x0 0x01e47000 0x0 0x2000>,
		      <0x0 0x01e04000 0x0 0x2c000>;
		reg-names = "ipa-reg", "ipa-shared", "gsi";

		iommus = <&apps_smmu 0x1520 0x0>,
			 <&apps_smmu 0x1522 0x0>;

		interrupts-extended = <&intc GIC_SPI 311 IRQ_TYPE_EDGE_RISING 0>,
				      <&intc GIC_SPI 432 IRQ_TYPE_LEVEL_HIGH 0>,
				      <&modem_smp2p_ipa_in 0 IRQ_TYPE_EDGE_RISING>,
				      <&modem_smp2p_ipa_in 1 IRQ_TYPE_EDGE_RISING>;
		interrupt-names = "ipa", "gsi", "ipa-clock-query", "ipa-setup-ready";

		clocks = <&rpmhcc RPMH_IPA_CLK>;
		clock-names = "core";

		interconnects = <&aggre1_noc MASTER_IPA QCOM_ICC_TAG_ALWAYS
				 &mc_virt SLAVE_EBI1 QCOM_ICC_TAG_ALWAYS>,
				<&aggre1_noc MASTER_IPA QCOM_ICC_TAG_ALWAYS
				 &system_noc SLAVE_IMEM QCOM_ICC_TAG_ALWAYS>,
				<&gem_noc MASTER_APPSS_PROC QCOM_ICC_TAG_ALWAYS
				 &config_noc SLAVE_IPA_CFG QCOM_ICC_TAG_ALWAYS>;
		interconnect-names = "memory", "imem", "config";

		qcom,qmp = <&aoss_qmp>;

		qcom,smem-states = <&modem_smp2p_ipa_out 0>,
				   <&modem_smp2p_ipa_out 1>;
		qcom,smem-state-names = "ipa-clock-enabled-valid",
					"ipa-clock-enabled";

		/*
		 * The AP loads the GSI firmware (downstream: PIL "ipa_fws", PAS id 15, region
		 * ips_fw_region@0x9a900000). With "modem-init" the modem never raised ipa-setup-ready,
		 * the AP never set up IPA/QMI, and the modem asserted 40 s after every start.
		 * ipa_fws.* is copied into the rootfs by a70q-mainline-modem (needed at probe time).
		 */
		qcom,gsi-loader = "self";
		memory-region = <&ips_fw_mem>;
		firmware-name = "qcom/a70q/ipa_fws.mdt";
	};
};

&{/soc@0} {
	remoteproc_mpss: remoteproc@4080000 {
		compatible = "qcom,sm8150-mpss-pas";
		reg = <0x0 0x04080000 0x0 0x4040>;

		interrupts-extended = <&intc GIC_SPI 266 IRQ_TYPE_EDGE_RISING 0>,
				      <&modem_smp2p_in 0 IRQ_TYPE_EDGE_RISING>,
				      <&modem_smp2p_in 1 IRQ_TYPE_EDGE_RISING>,
				      <&modem_smp2p_in 2 IRQ_TYPE_EDGE_RISING>,
				      <&modem_smp2p_in 3 IRQ_TYPE_EDGE_RISING>,
				      <&modem_smp2p_in 7 IRQ_TYPE_EDGE_RISING>;
		interrupt-names = "wdog", "fatal", "ready", "handover",
				  "stop-ack", "shutdown-ack";

		clocks = <&rpmhcc RPMH_CXO_CLK>;
		clock-names = "xo";

		power-domains = <&rpmhpd RPMHPD_CX>,
				<&rpmhpd RPMHPD_MSS>;
		power-domain-names = "cx", "mss";

		memory-region = <&modem_mem>;
		qcom,qmp = <&aoss_qmp>;

		qcom,smem-states = <&modem_smp2p_out 0>;
		qcom,smem-state-names = "stop";

		glink-edge {
			interrupts = <GIC_SPI 449 IRQ_TYPE_EDGE_RISING 0>;
			label = "modem";
			qcom,remote-pid = <1>;
			mboxes = <&apss_shared 12>;
		};
	};

	wifi: wifi@18800000 {
		compatible = "qcom,wcn3990-wifi";
		reg = <0x0 0x18800000 0x0 0x800000>;
		reg-names = "membase";
		memory-region = <&wlan_msa_mem>;
		interrupts = <GIC_SPI 414 IRQ_TYPE_LEVEL_HIGH 0>,
			     <GIC_SPI 415 IRQ_TYPE_LEVEL_HIGH 0>,
			     <GIC_SPI 416 IRQ_TYPE_LEVEL_HIGH 0>,
			     <GIC_SPI 417 IRQ_TYPE_LEVEL_HIGH 0>,
			     <GIC_SPI 418 IRQ_TYPE_LEVEL_HIGH 0>,
			     <GIC_SPI 419 IRQ_TYPE_LEVEL_HIGH 0>,
			     <GIC_SPI 420 IRQ_TYPE_LEVEL_HIGH 0>,
			     <GIC_SPI 421 IRQ_TYPE_LEVEL_HIGH 0>,
			     <GIC_SPI 422 IRQ_TYPE_LEVEL_HIGH 0>,
			     <GIC_SPI 423 IRQ_TYPE_LEVEL_HIGH 0>,
			     <GIC_SPI 424 IRQ_TYPE_LEVEL_HIGH 0>,
			     <GIC_SPI 425 IRQ_TYPE_LEVEL_HIGH 0>;
		iommus = <&apps_smmu 0x1640 0x1>;
		vdd-0.8-cx-mx-supply = <&vreg_l9a>;
		vdd-1.8-xo-supply = <&vreg_l1c>;
		vdd-1.3-rfa-supply = <&vreg_l2c>;
		vdd-3.3-ch0-supply = <&vreg_l10c>;
	};
};

/*
 * Bluetooth: WCN3988 on QUP1 SE3 (uart7 = downstream ttyHS0 at 0xa8c000), the same chip as the
 * WiFi; supplies from the downstream bt_wcn3990 node (core = pm6150l_l1, pa = pm6150l_l2,
 * ldo = pm6150l_l10). Firmware qca/apbtfw11.tlv + qca/apnv11.bin from the vendor partition.
 */
&qupv3_id_1 {
	status = "okay";
};

/ {
	aliases {
		/* qcom_geni_serial needs an alias for the line number */
		serial1 = &uart7;
	};
};

&uart7 {
	status = "okay";

	bluetooth {
		compatible = "qcom,wcn3988-bt";
		vddio-supply = <&vreg_l1c>;
		vddxo-supply = <&vreg_l1c>;
		vddrf-supply = <&vreg_l2c>;
		vddch0-supply = <&vreg_l10c>;
		max-speed = <3200000>;
	};
};

/*
 * Audio DSP. Samsung's ADSP firmware speaks the legacy APR protocol ("apr_audio_svc" glink
 * channel), not AudioReach (talos.dtsi's gpr/q6apm), as found by the violet-sm6150-mainline
 * project for the same SoC. Firmware from the apnhlos partition, symlinked to qcom/a70q/ by
 * a70q-mainline-modem, which also starts the remoteproc (the partition is not mounted at probe).
 */
&remoteproc_adsp {
	firmware-name = "qcom/a70q/adsp.mdt";
	status = "okay";
};

&glink_edge {
	/delete-node/ gpr;

	apr {
		compatible = "qcom,apr-v2";
		qcom,glink-channels = "apr_audio_svc";
		qcom,domain = <APR_DOMAIN_ADSP>;
		#address-cells = <1>;
		#size-cells = <0>;

		service@3 {
			compatible = "qcom,q6core";
			reg = <APR_SVC_ADSP_CORE>;
			qcom,protection-domain = "avs/audio", "msm/adsp/audio_pd";
		};

		q6afe: service@4 {
			compatible = "qcom,q6afe";
			reg = <APR_SVC_AFE>;
			qcom,protection-domain = "avs/audio", "msm/adsp/audio_pd";

			q6afedai: dais {
				compatible = "qcom,q6afe-dais";
				#address-cells = <1>;
				#size-cells = <0>;
				#sound-dai-cells = <1>;
			};

			q6afecc: clock-controller {
				compatible = "qcom,q6afe-clocks";
				#clock-cells = <2>;
			};
		};

		q6asm: service@7 {
			compatible = "qcom,q6asm";
			reg = <APR_SVC_ASM>;
			qcom,protection-domain = "avs/audio", "msm/adsp/audio_pd";

			q6asmdai: dais {
				compatible = "qcom,q6asm-dais";
				#address-cells = <1>;
				#size-cells = <0>;
				#sound-dai-cells = <1>;
				iommus = <&apps_smmu 0x1721 0x0>;

				dai@0 {
					reg = <MSM_FRONTEND_DAI_MULTIMEDIA1>;
				};

				dai@1 {
					reg = <MSM_FRONTEND_DAI_MULTIMEDIA2>;
				};
			};
		};

		q6adm: service@8 {
			compatible = "qcom,q6adm";
			reg = <APR_SVC_ADM>;
			qcom,protection-domain = "avs/audio", "msm/adsp/audio_pd";

			q6routing: routing {
				compatible = "qcom,q6adm-routing";
				#sound-dai-cells = <0>;
			};
		};
	};
};

/*
 * Status: the ADSP rejects only the VA core clock (0x30b, ADSP_EBADPARAM; all other codec
 * clocks are accepted), so the VA macro (fsgen) is clocked from TX core as downstream does. The
 * macros, the WSA SoundWire master (HW v1.5.0) and the sound card come up without errors, but
 * the WSA881x stays UNATTACHED: it sits at device 0 (MCP_SLV_STATUS 0x1), the hardware
 * enumerator never latches its ID and the bus reports a clash (downstream uses the older
 * swr-wcd driver with software enumeration). The sound card node stays disabled until then.
 *
 * With the macros and the SoundWire master enabled the modem asserts every 40 s (bisected over
 * several boots: 6 crashes in 4 min with them, 0 without), so they are disabled as well.
 *
 * Speaker: one WSA881x (SoundWire 0x21170213 = unique id 3) on the WSA macro's SoundWire master,
 * SD_N on GPIO 108. Addresses/clocks from the downstream bolero-cdc node: wsa-macro@62f00000,
 * swrm @62f10000 irq SPI 136, va-macro@62f20000 (provides "fsgen"). The LPASS clock VOTE
 * command ("macro"/"dcodec" clocks) is not supported by this ADSP firmware (violet), so it is
 * not used.
 */
&soc {
	/*
	 * IMEM restart reason (downstream qcom,msm-imem-restart_reason @0x65c): the bootloader
	 * reads it to pick recovery/bootloader, as with the downstream kernel's reboot(RESTART2).
	 */
	imem@146aa000 {
		compatible = "syscon", "simple-mfd";
		reg = <0x0 0x146aa000 0x0 0x1000>;

		reboot-mode {
			compatible = "syscon-reboot-mode";
			offset = <0x65c>;
			mode-normal = <0x77665501>;
			mode-bootloader = <0x77665500>;
			mode-recovery = <0x77665502>;
		};
	};

	vamacro: codec@62f20000 {
		/* still needed: it detects the codec version the other macros use */
		compatible = "qcom,sm8250-lpass-va-macro";
		reg = <0x0 0x62f20000 0x0 0x1000>;
		/*
		 * pm_clk enables these in DT order: the LPASS core (macro block) vote has to come
		 * before the codec clocks, or the AFE rejects them (ADSP_EBADPARAM). There is no
		 * DCODEC block on this firmware (vote -> ADSP_EUNSUPPORTED).
		 */
		/*
		 * This ADSP rejects the VA core clock (0x30b, ADSP_EBADPARAM) but accepts all the
		 * other codec clocks; downstream runs bolero with "va-without-decimation" and the TX
		 * macro clock as the codec MCLK, so clock the VA macro (fsgen) from TX core.
		 */
		clocks = <&q6afecc LPASS_HW_MACRO_VOTE LPASS_CLK_ATTRIBUTE_COUPLE_NO>,
			 <&q6afecc LPASS_CLK_ID_TX_CORE_MCLK LPASS_CLK_ATTRIBUTE_COUPLE_NO>;
		clock-names = "macro", "mclk";

		#clock-cells = <0>;
		clock-output-names = "fsgen";
		#sound-dai-cells = <1>;
	};

	txmacro: codec@62ec0000 {
		compatible = "qcom,sm8250-lpass-tx-macro";
		reg = <0x0 0x62ec0000 0x0 0x1000>;
		clocks = <&q6afecc LPASS_HW_MACRO_VOTE LPASS_CLK_ATTRIBUTE_COUPLE_NO>,
			 <&q6afecc LPASS_CLK_ID_TX_CORE_MCLK LPASS_CLK_ATTRIBUTE_COUPLE_NO>,
			 <&q6afecc LPASS_CLK_ID_TX_CORE_NPL_MCLK LPASS_CLK_ATTRIBUTE_COUPLE_NO>;
		clock-names = "macro", "mclk", "npl";
		pinctrl-0 = <&tx_swr_active>, <&wcd_reset_n>;
		pinctrl-names = "default";

		#clock-cells = <0>;
		clock-output-names = "lpass-tx-mclk";
		#sound-dai-cells = <1>;
	};

	wsamacro: codec@62f00000 {
		compatible = "qcom,sm8250-lpass-wsa-macro";
		reg = <0x0 0x62f00000 0x0 0x1000>;
		clocks = <&q6afecc LPASS_HW_MACRO_VOTE LPASS_CLK_ATTRIBUTE_COUPLE_NO>,
			 <&q6afecc LPASS_CLK_ID_WSA_CORE_MCLK LPASS_CLK_ATTRIBUTE_COUPLE_NO>,
			 <&q6afecc LPASS_CLK_ID_WSA_CORE_NPL_MCLK LPASS_CLK_ATTRIBUTE_COUPLE_NO>,
			 <&txmacro>;
		/* fsgen: the TX macro MCLK/FS counter, the codec MCLK source on SM6150 (downstream) */
		clock-names = "macro", "mclk", "npl", "fsgen";

		#clock-cells = <0>;
		clock-output-names = "mclk";
		#sound-dai-cells = <1>;

		/*
		 * Also hold the speaker amp in shutdown (SD_N low) before the SoundWire bus starts: TLMM
		 * keeps its state over a warm reset, and a WSA881x still attached from the previous kernel
		 * drives the bus (bus clash, never re-enumerates). wsa881x then releases SD_N.
		 */
		pinctrl-0 = <&wsa_swr_active>, <&wsa_spkr_sd_n_on>;
		pinctrl-names = "default";
	};

	swr0: soundwire@62f10000 {
		/* SWRM_COMP_HW_VERSION reads 0x01050000 (v1.5.0) */
		compatible = "qcom,soundwire-v1.5.0";
		reg = <0x0 0x62f10000 0x0 0x2000>;
		interrupts = <GIC_SPI 136 IRQ_TYPE_LEVEL_HIGH 0>;
		clocks = <&wsamacro>;
		clock-names = "iface";
		label = "WSA";

		/* this controller (v1.3) has 6 dout + 3 din ports */
		qcom,din-ports = <3>;
		qcom,dout-ports = <6>;

		qcom,ports-sinterval-low =	/bits/ 8 <0x07 0x1f 0x3f 0x07 0x1f 0x3f 0x0f 0x0f 0x0f>;
		qcom,ports-offset1 =		/bits/ 8 <0x01 0x02 0x0c 0x06 0x12 0x0d 0x07 0x0a 0x0a>;
		qcom,ports-offset2 =		/bits/ 8 <0xff 0x00 0x1f 0xff 0x00 0x1f 0x00 0x00 0x00>;
		qcom,ports-block-pack-mode =	/bits/ 8 <0x0 0x0 0x1 0x0 0x0 0x1 0x0 0x0 0x0>;

		#sound-dai-cells = <1>;
		#address-cells = <2>;
		#size-cells = <0>;

		spkr: speaker@0,3 {
			compatible = "sdw10217211000";
			reg = <0 3>;
			/* downstream spkr_1_sd_n (wsa_spkr_en1_pinctrl): GPIO 108 */
			powerdown-gpios = <&tlmm 108 GPIO_ACTIVE_LOW>;
			#thermal-sensor-cells = <0>;
			sound-name-prefix = "SpkrLeft";
			#sound-dai-cells = <0>;
		};
	};

	/*
	 * Headset / mics: WCD937x on the RX (0x62ef0000, SPI 138) and TX (0x62ed0000, SPI 137)
	 * SoundWire masters (downstream rx_swr_master / tx_swr_master), RX: unique id 4
	 * (0x1170224), TX: unique id 3 (0x1170223). Reset on LPASS LPI GPIO 24, SoundWire pins on
	 * LPI GPIO 18-23.
	 */
	lpi_tlmm: pinctrl@62b40000 {
		compatible = "qcom,sm6150-lpass-lpi-pinctrl";
		reg = <0x0 0x62b40000 0x0 0x20000>;
		clocks = <&q6afecc LPASS_HW_MACRO_VOTE LPASS_CLK_ATTRIBUTE_COUPLE_NO>;
		clock-names = "core";
		gpio-controller;
		#gpio-cells = <2>;
		gpio-ranges = <&lpi_tlmm 0 0 32>;
		/* owned by the ADSP (downstream gpio-reserved-ranges) */
		gpio-reserved-ranges = <0 8>, <12 6>, <25 5>;

		rx_swr_active: rx-swr-active-state {
			clk-pins {
				pins = "gpio21";
				function = "swr_rx_clk";
				drive-strength = <8>;
				bias-bus-hold;
			};

			data-pins {
				pins = "gpio22", "gpio23";
				function = "swr_rx_data";
				drive-strength = <8>;
				bias-bus-hold;
			};
		};

		tx_swr_active: tx-swr-active-state {
			clk-pins {
				pins = "gpio18";
				function = "swr_tx_clk";
				drive-strength = <8>;
				bias-bus-hold;
			};

			data-pins {
				pins = "gpio19", "gpio20";
				function = "swr_tx_data";
				drive-strength = <8>;
				bias-bus-hold;
			};
		};

		/*
		 * WCD937x held in reset (low) from TX macro probe, before the TX/RX SoundWire masters
		 * start: after a warm reset the codec is still attached from the previous kernel and
		 * clashes with the new bus (as the WSA881x). wcd937x then releases it (reset-gpios).
		 */
		wcd_reset_n: wcd-reset-n-state {
			pins = "gpio24";
			function = "wcd_reset";
			drive-strength = <16>;
			output-low;
		};
	};

	rxmacro: codec@62ee0000 {
		compatible = "qcom,sm8250-lpass-rx-macro";
		reg = <0x0 0x62ee0000 0x0 0x1000>;
		clocks = <&q6afecc LPASS_HW_MACRO_VOTE LPASS_CLK_ATTRIBUTE_COUPLE_NO>,
			 <&q6afecc LPASS_CLK_ID_RX_CORE_MCLK LPASS_CLK_ATTRIBUTE_COUPLE_NO>,
			 <&q6afecc LPASS_CLK_ID_RX_CORE_NPL_MCLK LPASS_CLK_ATTRIBUTE_COUPLE_NO>,
			 <&txmacro>;
		clock-names = "macro", "mclk", "npl", "fsgen";
		pinctrl-0 = <&rx_swr_active>;
		pinctrl-names = "default";

		#clock-cells = <0>;
		clock-output-names = "mclk-rx";
		#sound-dai-cells = <1>;
	};

	swr1: soundwire@62ef0000 {
		compatible = "qcom,soundwire-v1.5.0";
		reg = <0x0 0x62ef0000 0x0 0x2000>;
		interrupts = <GIC_SPI 138 IRQ_TYPE_LEVEL_HIGH 0>;
		clocks = <&rxmacro>;
		clock-names = "iface";
		label = "RX";

		/* SWRM_COMP_PARAMS: 6 dout + 1 din; ports 1-5 as Kodiak (WCD937x RX) */
		qcom,din-ports = <1>;
		qcom,dout-ports = <6>;

		qcom,ports-word-length =	/bits/ 8 <0x01 0x07 0x04 0xff 0xff 0xff 0xff>;
		qcom,ports-sinterval-low =	/bits/ 8 <0x03 0x3f 0x1f 0x03 0x03 0x03 0x03>;
		qcom,ports-offset1 =		/bits/ 8 <0x00 0x00 0x0b 0x01 0x01 0x01 0x01>;
		qcom,ports-offset2 =		/bits/ 8 <0x00 0x00 0x0b 0x00 0x00 0x00 0x00>;
		/* HPH on data lane 1 (LPI GPIO 23), as SM8250/Kodiak: otherwise it collides with COMP */
		qcom,ports-lane-control =	/bits/ 8 <0x01 0x00 0x00 0x00 0x00 0x00 0x00>;
		qcom,ports-block-pack-mode =	/bits/ 8 <0xff 0x00 0x01 0xff 0xff 0xff 0xff>;
		qcom,ports-hstart =		/bits/ 8 <0xff 0x03 0xff 0xff 0xff 0xff 0xff>;
		qcom,ports-hstop =		/bits/ 8 <0xff 0x06 0xff 0xff 0xff 0xff 0xff>;
		qcom,ports-block-group-count =	/bits/ 8 <0xff 0xff 0xff 0xff 0x00 0xff 0xff>;

		#sound-dai-cells = <1>;
		#address-cells = <2>;
		#size-cells = <0>;

		wcd937x_rx: codec@0,4 {
			compatible = "sdw20217010a00";
			reg = <0 4>;
			/* downstream qcom,swr-port-mapping: HPH 1, CLSH 2, COMP 3, LO 4, DSD 5 */
			qcom,rx-port-mapping = <1 2 3 4 5>;
		};
	};

	swr2: soundwire@62ed0000 {
		compatible = "qcom,soundwire-v1.5.0";
		reg = <0x0 0x62ed0000 0x0 0x2000>;
		interrupts = <GIC_SPI 137 IRQ_TYPE_LEVEL_HIGH 0>;
		clocks = <&txmacro>;
		clock-names = "iface";
		label = "TX";

		/*
		 * SWRM_COMP_PARAMS: 1 dout (port 1) + 6 din (ports 2-7); ADC on port 2, DMIC/MBHC on
		 * 4 (downstream port mapping), parameters as the Kodiak TX master
		 */
		qcom,din-ports = <6>;
		qcom,dout-ports = <1>;

		/* port 2 (ADC) as read back downstream while recording: sinterval 3, offset1 1, lane 0 */
		qcom,ports-sinterval-low =	/bits/ 8 <0x03 0x03 0x03 0x03 0x03 0x03 0x03>;
		qcom,ports-offset1 =		/bits/ 8 <0x00 0x01 0x00 0x02 0x02 0x02 0x02>;
		qcom,ports-offset2 =		/bits/ 8 <0x00 0x00 0x00 0x00 0x00 0x00 0x00>;
		qcom,ports-hstart =		/bits/ 8 <0xff 0xff 0xff 0xff 0xff 0xff 0xff>;
		qcom,ports-hstop =		/bits/ 8 <0xff 0xff 0xff 0xff 0xff 0xff 0xff>;
		qcom,ports-word-length =	/bits/ 8 <0xff 0xff 0x00 0xff 0xff 0xff 0xff>;
		qcom,ports-block-pack-mode =	/bits/ 8 <0xff 0xff 0xff 0xff 0xff 0xff 0xff>;
		qcom,ports-block-group-count =	/bits/ 8 <0xff 0xff 0xff 0xff 0xff 0xff 0xff>;
		/* port 3 (ADC2/3) on data lane 1 (LPI GPIO 20), as SM8250 */
		qcom,ports-lane-control =	/bits/ 8 <0x00 0x00 0x01 0x00 0x00 0x00 0x00>;

		#sound-dai-cells = <1>;
		#address-cells = <2>;
		#size-cells = <0>;

		wcd937x_tx: codec@0,3 {
			compatible = "sdw20217010a00";
			reg = <0 3>;
			/*
			 * WCD TX1 (ADC1) -> master port 2 (TX SWR_ADC0), TX2 (ADC2/3) -> 3 (SWR_ADC2, as
			 * downstream routes ADC2_OUTPUT), TX3 (DMIC0-3, MBHC) -> 4, TX4 (DMIC4-7) -> 5
			 */
			qcom,tx-port-mapping = <2 3 4 5>;
		};
	};

	sound {
		compatible = "qcom,sm8250-sndcard";
		model = "Samsung Galaxy A70";
		audio-routing = "SpkrLeft IN", "WSA_SPK1 OUT",
				"IN1_HPHL", "HPHL_OUT",
				"IN2_HPHR", "HPHR_OUT",
				"AMIC1", "MIC BIAS1",
				"AMIC2", "MIC BIAS2",
				"AMIC3", "MIC BIAS3",
				"TX SWR_ADC0", "ADC1_OUTPUT",
				"TX SWR_ADC2", "ADC2_OUTPUT";

		mm1-dai-link {
			link-name = "MultiMedia1";
			cpu {
				sound-dai = <&q6asmdai MSM_FRONTEND_DAI_MULTIMEDIA1>;
			};
		};

		mm2-dai-link {
			link-name = "MultiMedia2";
			cpu {
				sound-dai = <&q6asmdai MSM_FRONTEND_DAI_MULTIMEDIA2>;
			};
		};

		wsa-dai-link {
			link-name = "WSA Playback";
			cpu {
				sound-dai = <&q6afedai WSA_CODEC_DMA_RX_0>;
			};
			platform {
				sound-dai = <&q6routing>;
			};
			codec {
				sound-dai = <&spkr>, <&swr0 0>, <&wsamacro 0>;
			};
		};

		wcd-playback-dai-link {
			link-name = "WCD Playback";
			cpu {
				sound-dai = <&q6afedai RX_CODEC_DMA_RX_0>;
			};
			platform {
				sound-dai = <&q6routing>;
			};
			codec {
				sound-dai = <&wcd937x 0>, <&swr1 0>, <&rxmacro 0>;
			};
		};

		wcd-capture-dai-link {
			link-name = "WCD Capture";
			cpu {
				sound-dai = <&q6afedai TX_CODEC_DMA_TX_3>;
			};
			platform {
				sound-dai = <&q6routing>;
			};
			codec {
				/* swr2 DAI 0 is its one dout port; DAI 1 = first din */
				sound-dai = <&wcd937x 1>, <&swr2 1>, <&txmacro 0>;
			};
		};
	};
};

/ {
	wcd937x: audio-codec {
		compatible = "qcom,wcd9370-codec";
		reset-gpios = <&lpi_tlmm 24 GPIO_ACTIVE_LOW>;

		vdd-buck-supply = <&vreg_l15a>;
		vdd-rxtx-supply = <&vreg_l10a>;
		vdd-px-supply = <&vreg_l10a>;
		vdd-mic-bias-supply = <&vreg_bob>;

		/* downstream qcom,cdc-micbias{1,2,3}-mv: 1800, 2800, 1800 */
		qcom,micbias1-microvolt = <1800000>;
		qcom,micbias2-microvolt = <2800000>;
		qcom,micbias3-microvolt = <1800000>;

		/* headset detection (downstream qcom,msm-mbhc-hphl-swh = 1, gnd-swh = 0) */
		qcom,ground-jack-type-normally-closed;
		qcom,mbhc-headset-vthreshold-microvolt = <9999000>;
		qcom,mbhc-headphone-vthreshold-microvolt = <640000>;
		qcom,mbhc-buttons-vthreshold-microvolt = <75000 150000 237000 500000
							  500000 500000 500000 500000>;

		qcom,rx-device = <&wcd937x_rx>;
		qcom,tx-device = <&wcd937x_tx>;

		#sound-dai-cells = <1>;
	};
};

&tlmm {
	cam_mclk0_default: cam-mclk0-default-state {
		pins = "gpio28";
		function = "cam_mclk";
		drive-strength = <6>;
		bias-disable;
	};

	cam_mclk1_default: cam-mclk1-default-state {
		pins = "gpio29";
		function = "cam_mclk";
		drive-strength = <6>;
		bias-disable;
	};

	cam_mclk2_default: cam-mclk2-default-state {
		pins = "gpio30";
		function = "cam_mclk";
		drive-strength = <6>;
		bias-disable;
	};

	cam_mclk3_default: cam-mclk3-default-state {
		pins = "gpio31";
		function = "cam_mclk";
		drive-strength = <6>;
		bias-disable;
	};

	cam_pmic_i2c_default: cam-pmic-i2c-default-state {
		pins = "gpio117", "gpio118";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
	};

	/* speaker amp out of shutdown before the SoundWire bus starts (downstream spkr_1_sd_n_active) */
	wsa_spkr_sd_n_on: wsa-spkr-sd-n-on-state {
		pins = "gpio108";
		function = "gpio";
		drive-strength = <16>;
		bias-disable;
		output-high;
	};

	wsa_swr_active: wsa-swr-active-state {
		clk-pins {
			pins = "gpio111";
			function = "wsa_clk";
			drive-strength = <2>;
			bias-bus-hold;
		};

		data-pins {
			pins = "gpio110";
			function = "wsa_data";
			drive-strength = <4>;
			bias-bus-hold;
		};
	};
};

/*
 * Camera Control Interface (talos.dtsi cci@ac4a000, as downstream qcom,cci@ac4a000: CCI0 GPIO 32/33,
 * CCI1 GPIO 34/35; all the sensors use cci-master 1).
 */
&cci {
	status = "okay";
};

/*
 * Rear camera: Samsung S5KGD1 at 0x2d on CCI0 (chip ID 0x0841), downstream cam-sensor@0:
 * vio = S2MPB03 LDO3, vdig = LDO2, vana = LDO6, vaf = L19A, MCLK0 (GPIO 28) at 24 MHz, reset
 * GPIO 47, CSIPHY0, 4 lanes.
 */
&cci_i2c0 {
	rear_cam: camera@2d {
		compatible = "samsung,s5kgd1";
		reg = <0x2d>;
		clocks = <&camcc CAM_CC_MCLK0_CLK>;
		assigned-clocks = <&camcc CAM_CC_MCLK0_CLK>;
		assigned-clock-rates = <24000000>;
		reset-gpios = <&tlmm 47 GPIO_ACTIVE_LOW>;
		vddio-supply = <&cam_ldo3>;
		vddd-supply = <&cam_ldo2>;
		vdda-supply = <&cam_ldo6>;
		afvdd-supply = <&vreg_l19a>;
		/* downstream sensor-position-roll = 90 */
		orientation = <1>;
		rotation = <90>;
		pinctrl-0 = <&cam_mclk0_default>;
		pinctrl-names = "default";

		port {
			rear_cam_ep: endpoint {
				data-lanes = <1 2 3 4>;
				link-frequencies = /bits/ 64 <513000000>;
				remote-endpoint = <&csiphy0_ep>;
			};
		};
	};
};

/*
 * Front camera: Samsung S5KGD1 at 0x10 on CCI1 (vendor module 1: slave 0x20, ID 0x0841, same
 * register tables as the rear one), downstream cam-sensor@1: vio = S2MPB03 LDO3, vdig = LDO1,
 * vana = LDO5, MCLK1 (GPIO 29) 24 MHz, reset GPIO 45, MIPI switch GPIO 49 (kept low), CSIPHY1.
 */
&cci_i2c1 {
	/* rear camera focus: FitiPower FP5529 (vendor actuatorName "fp5529"), downstream actuator on CCI1 */
	rear_vcm: lens@c {
		compatible = "fitipower,fp5529";
		reg = <0x0c>;
		vdd-supply = <&vreg_l19a>;
		vio-supply = <&cam_ldo3>;
		/* does not answer at 0x0c on CCI1 yet (address/bus to be confirmed) */
		status = "disabled";
	};

	/*
	 * Depth camera: GalaxyCore GC5035 on CCI1, downstream cam-sensor@3: vio = S2MPB03 LDO3,
	 * vdig = LDO4, vana = LDO7, MCLK2 (GPIO 30) 24 MHz, reset GPIO 46, CSIPHY2, 2 lanes.
	 */
	depth_cam: camera@37 {
		compatible = "galaxycore,gc5035";
		reg = <0x37>;
		clocks = <&camcc CAM_CC_MCLK2_CLK>;
		assigned-clocks = <&camcc CAM_CC_MCLK2_CLK>;
		assigned-clock-rates = <24000000>;
		reset-gpios = <&tlmm 46 GPIO_ACTIVE_LOW>;
		vddio-supply = <&cam_ldo3>;
		vddd-supply = <&cam_ldo4>;
		vdda-supply = <&cam_ldo7>;
		orientation = <1>;
		rotation = <90>;
		pinctrl-0 = <&cam_mclk2_default>;
		pinctrl-names = "default";

		port {
			depth_cam_ep: endpoint {
				data-lanes = <1 2>;
				link-frequencies = /bits/ 64 <438000000>;
				remote-endpoint = <&csiphy2_ep>;
			};
		};
	};

	front_cam: camera@10 {
		compatible = "samsung,s5kgd1";
		reg = <0x10>;
		clocks = <&camcc CAM_CC_MCLK1_CLK>;
		assigned-clocks = <&camcc CAM_CC_MCLK1_CLK>;
		assigned-clock-rates = <24000000>;
		reset-gpios = <&tlmm 45 GPIO_ACTIVE_LOW>;
		vddio-supply = <&cam_ldo3>;
		vddd-supply = <&cam_ldo1>;
		vdda-supply = <&cam_ldo5>;
		/* downstream sensor-position-roll = 270 */
		orientation = <0>;
		rotation = <270>;
		/* CSIPHY1 is shared with the ultra wide camera through cam_csi1_mux (input 0) */
		pinctrl-0 = <&cam_mclk1_default>;
		pinctrl-names = "default";

		port {
			front_cam_ep: endpoint {
				data-lanes = <1 2 3 4>;
				link-frequencies = /bits/ 64 <513000000>;
				remote-endpoint = <&vmux_front_ep>;
			};
		};
	};

	/*
	 * Ultra wide camera: Samsung S5K4HA at 0x2d on CCI1 (vendor module 2: slave 0x5a, ID 0x48ab),
	 * downstream cam-sensor@2: vio = S2MPB03 LDO3, vdig ("cam_v_custom1") = LDO2, vana through
	 * GPIO 95, MCLK3 (GPIO 31) 24 MHz, reset GPIO 100, MIPI switch GPIO 49 high, CSIPHY1.
	 */
	wide_cam: camera@2d {
		compatible = "samsung,s5k4ha";
		reg = <0x2d>;
		clocks = <&camcc CAM_CC_MCLK3_CLK>;
		assigned-clocks = <&camcc CAM_CC_MCLK3_CLK>;
		assigned-clock-rates = <24000000>;
		reset-gpios = <&tlmm 100 GPIO_ACTIVE_LOW>;
		vddio-supply = <&cam_ldo3>;
		vddd-supply = <&cam_ldo2>;
		vdda-supply = <&wide_cam_vana>;
		/* downstream sensor-position-roll = 90 */
		orientation = <1>;
		rotation = <90>;
		pinctrl-0 = <&cam_mclk3_default>;
		pinctrl-names = "default";

		/* CSIPHY1 through cam_csi1_mux (input 1) */
		port {
			wide_cam_ep: endpoint {
				data-lanes = <1 2 3 4>;
				link-frequencies = /bits/ 64 <334000000>;
				remote-endpoint = <&vmux_wide_ep>;
			};
		};
	};
};

/*
 * Front and ultra wide camera share CSIPHY1 through a MIPI lane switch on GPIO 49 (low = front,
 * high = wide; downstream gpio table of both sensors). A second endpoint on the CSIPHY port does
 * not work (CAMSS takes one remote per port), so the switch is a video-mux; CAMSS follows the
 * enabled mux input to find the sensor (patch 0046).
 */
/ {
	cam_mipi_sel: mux-controller-cam-mipi {
		compatible = "gpio-mux";
		#mux-control-cells = <0>;
		mux-gpios = <&tlmm 49 GPIO_ACTIVE_HIGH>;
	};

	cam_csi1_mux: video-mux {
		compatible = "video-mux";
		mux-controls = <&cam_mipi_sel>;
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			vmux_front_ep: endpoint {
				remote-endpoint = <&front_cam_ep>;
			};
		};

		port@1 {
			reg = <1>;
			vmux_wide_ep: endpoint {
				remote-endpoint = <&wide_cam_ep>;
			};
		};

		port@2 {
			reg = <2>;
			vmux_out_ep: endpoint {
				remote-endpoint = <&csiphy1_ep>;
			};
		};
	};
};

/ {
	/* ultra wide camera analog supply: switched by GPIO 95 (downstream CAM_VANA) */
	wide_cam_vana: regulator-wide-cam-vana {
		compatible = "regulator-fixed";
		regulator-name = "wide_cam_vana";
		regulator-min-microvolt = <2800000>;
		regulator-max-microvolt = <2800000>;
		gpio = <&tlmm 95 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		startup-delay-us = <1000>;
	};
};

/* CSI PHY supplies as downstream csiphy (mipi-csi-vdd = pm6150l_l3, 1.2 V) */
&camss {
	vdd-csiphy-1p2-supply = <&vreg_l3c>;
	vdd-csiphy-1p8-supply = <&vreg_l12a>;
	status = "okay";

	ports {
		port@0 {
			csiphy0_ep: endpoint {
				data-lanes = <0 1 2 3>;
				remote-endpoint = <&rear_cam_ep>;
			};
		};

		port@1 {
			csiphy1_ep: endpoint {
				data-lanes = <0 1 2 3>;
				remote-endpoint = <&vmux_out_ep>;
			};
		};

		port@2 {
			csiphy2_ep: endpoint {
				data-lanes = <0 1>;
				remote-endpoint = <&depth_cam_ep>;
			};
		};
	};
};

/*
 * Camera sensor supplies: Samsung S2MPB03 PMIC (0x56) on a bit-banged I2C bus, SDA GPIO 117,
 * SCL GPIO 118 (downstream i2c@2 "i2c-gpio", s2mpb03@56). Voltages as the downstream
 * regulator nodes; consumers are the camera sensors.
 */
/ {
	i2c-cam-pmic {
		compatible = "i2c-gpio";
		sda-gpios = <&tlmm 117 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
		scl-gpios = <&tlmm 118 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
		i2c-gpio,delay-us = <2>;
		pinctrl-0 = <&cam_pmic_i2c_default>;
		pinctrl-names = "default";
		#address-cells = <1>;
		#size-cells = <0>;

		pmic@56 {
			compatible = "samsung,s2mpb03";
			reg = <0x56>;

			regulators {
				cam_ldo1: ldo1 {
					regulator-name = "cam_ldo1";
					regulator-min-microvolt = <1050000>;
					regulator-max-microvolt = <1050000>;
				};
				cam_ldo2: ldo2 {
					regulator-name = "cam_ldo2";
					regulator-min-microvolt = <1050000>;
					regulator-max-microvolt = <1050000>;
				};
				cam_ldo3: ldo3 {
					regulator-name = "cam_ldo3";
					regulator-min-microvolt = <1800000>;
					regulator-max-microvolt = <1800000>;
				};
				cam_ldo4: ldo4 {
					regulator-name = "cam_ldo4";
					regulator-min-microvolt = <1200000>;
					regulator-max-microvolt = <1200000>;
				};
				cam_ldo5: ldo5 {
					regulator-name = "cam_ldo5";
					regulator-min-microvolt = <2800000>;
					regulator-max-microvolt = <2800000>;
				};
				cam_ldo6: ldo6 {
					regulator-name = "cam_ldo6";
					regulator-min-microvolt = <2800000>;
					regulator-max-microvolt = <2800000>;
				};
				cam_ldo7: ldo7 {
					regulator-name = "cam_ldo7";
					regulator-min-microvolt = <2800000>;
					regulator-max-microvolt = <2800000>;
				};
			};
		};
	};

};

/*
 * Vibrator: coin DC motor driven by the PM6150L LPG channel at 0xbc00 (channel 3) through
 * PM6150L GPIO 6 in "func1" (downstream samsung_vib, pwms = <&pwms@bc00 0 1000000>). The pin
 * must be in this state: as a plain GPIO driven high it runs the motor continuously.
 */
&pm6150l_lpg {
	status = "okay";
};

&pm6150l_gpios {
	vib_pwm_default: vib-pwm-default-state {
		pins = "gpio6";
		function = "func1";
		output-low;
		bias-disable;
		/* no power-source: keep the PMIC default as downstream (pwm_out_gpio6_default) */
		qcom,drive-strength = <3>;
		drive-push-pull;
	};
};

/*
 * Vibration motor supply/driver: PM6150 vibrator LDO @0x5300 (SID 1). Downstream (samsung_vib +
 * qcom,qpnp-vibrator-ldo) vibrates by writing 3304 mV to 0x40/0x41 and setting bit 7 of 0x46 there
 * (register dump while vibrating); the LPG/PWM pin is not touched. Same block as PMI632.
 */
/*
 * SM6150 CPU frequencies the OSM lookup table offers on this phone but the QCS615-based talos.dtsi
 * OPP tables lack (qcom-cpufreq-hw: "Voltage update failed" and the level is dropped): silver
 * 1017.6 and 1708.8 MHz, gold 2016 MHz (A70: 6x 1.7 GHz + 2x 2.0 GHz). Bandwidth as the next level.
 */
&cpu0_opp_table {
	opp-1017600000 {
		opp-hz = /bits/ 64 <1017600000>;
		opp-peak-kBps = <(451000 * 4) (806400 * 16)>;
	};

	opp-1708800000 {
		opp-hz = /bits/ 64 <1708800000>;
		opp-peak-kBps = <(1017000 * 4) (1363200 * 16)>;
	};
};

&cpu6_opp_table {
	opp-2016000000 {
		opp-hz = /bits/ 64 <2016000000>;
		opp-peak-kBps = <(1555000 * 4) (1363200 * 16)>;
	};
};

/*
 * Crypto engine: its driver (CRYPTO_DEV_QCE) is BROKEN upstream, so the node never probes and the
 * interconnect providers wait for it in sync_state, keeping every path (DDR, LLCC, L3) at INT_MAX
 * bandwidth - DDR and CX never sleep.
 */
&crypto {
	status = "disabled";
};

/*
 * Cluster idle states: this phone's PSCI firmware takes the SM6150 downstream cluster modes
 * (lpm-levels, psci-mode-shift 4: l3-pc 0x04, cx-ret 0x124, llcc-off 0xb24), not the QCS615 ones in
 * talos.dtsi (0x134, 0xb34). With those, every CX retention / LLCC off attempt was rejected by
 * the firmware (genpd cluster S1 "Rejected" millions of times, usage 0), so CX and DDR never slept.
 */
&cluster_sleep_1 {
	arm,psci-suspend-param = <0x41001244>;
};

&cluster_sleep_2 {
	arm,psci-suspend-param = <0x4100b244>;
};

&pm6150_vib {
	status = "okay";
};

/* video codec: firmware from the apnhlos partition (venus.mdt + .bNN), linked by a70q-mainline-modem */
&venus {
	firmware-name = "qcom/a70q/venus.mdt";
	status = "okay";
};

/*
 * Rear flash LED: PM6150L flash module (downstream qcom,leds@d300 qpnp-flash-led-v2, channel id 0:
 * torch max 500 mA, flash max 1500 mA, 1280 ms).
 */
&pm6150l_flash {
	status = "okay";

	led-0 {
		function = LED_FUNCTION_FLASH;
		color = <LED_COLOR_ID_WHITE>;
		led-sources = <1>;
		led-max-microamp = <500000>;
		flash-max-microamp = <1500000>;
		flash-max-timeout-us = <1280000>;
	};
};



/*
 * microSD: SDHC2, card detect TLMM GPIO 99 active high (downstream cd-gpios flags 0). The card's
 * VDD goes through a load switch enabled by TLMM GPIO 121 (Samsung "sec,tflash-en-gpio") behind
 * L9C; without it the card answers but never finishes ACMD41 power-up ("Card stuck being busy").
 */
/ {
	vreg_sd_vdd: regulator-sd-vdd {
		compatible = "regulator-fixed";
		regulator-name = "sd_vdd";
		regulator-min-microvolt = <2952000>;
		regulator-max-microvolt = <2952000>;
		gpio = <&tlmm 121 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		vin-supply = <&vreg_l9c>;
		startup-delay-us = <10000>;
	};
};

&sdhc_2 {
	pinctrl-0 = <&sdc2_state_on>;
	pinctrl-1 = <&sdc2_state_off>;
	pinctrl-names = "default", "sleep";

	bus-width = <4>;
	cd-gpios = <&tlmm 99 GPIO_ACTIVE_HIGH>;	/* high = card present (measured) */

	vmmc-supply = <&vreg_sd_vdd>;
	vqmmc-supply = <&vreg_l6c>;


	/*
	 * UHS SDR104 (L6C at 1.8 V): the modem asserts that once blamed on it were the WCN3990 cx/mx
	 * supply being off at the first modem start (see vreg_l9a). SDR104 at 202 MHz, ~88 MB/s.
	 */
	status = "okay";
};

/*
 * USB Type-C: PM6150 Type-C/PD block (downstream qpnp-pdphy, vdd-pdphy = L17A) with the SMB5 OTG
 * boost as VBUS source: data role follows the cable (host for OTG adapters), sink by preference,
 * 5 V only so charging is not renegotiated.
 */
&pm6150_vbus {
	regulator-min-microamp = <500000>;
	regulator-max-microamp = <1000000>;
	status = "okay";
};

&pm6150_typec {
	vdd-pdphy-supply = <&vreg_l17a>;
	status = "okay";

	connector {
		compatible = "usb-c-connector";

		power-role = "dual";
		data-role = "dual";
		try-power-role = "sink";

		vbus-supply = <&pm6150_vbus>;

		source-pdos = <PDO_FIXED(5000, 1000, PDO_FIXED_DUAL_ROLE | PDO_FIXED_USB_COMM |
					 PDO_FIXED_DATA_SWAP)>;
		sink-pdos = <PDO_FIXED(5000, 3000, PDO_FIXED_DUAL_ROLE | PDO_FIXED_USB_COMM |
				       PDO_FIXED_DATA_SWAP)>;
		op-sink-microwatt = <10000000>;

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;

				pm6150_hs_in: endpoint {
					remote-endpoint = <&usb_1_role_switch_in>;
				};
			};
		};
	};
};
