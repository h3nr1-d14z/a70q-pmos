// SPDX-License-Identifier: GPL-2.0-only
/*
 * Samsung Galaxy A70 (SM-A705F, a70q) on mainline Linux — milestone 1: boot to an initramfs with
 * the bootloader's framebuffer (simple-framebuffer) and the console in ramoops, so the downstream
 * kernel can read the log after the next boot (/sys/fs/pstore). No regulators, UFS or USB yet.
 *
 * All addresses below come from the running downstream device tree
 * (pmos/mainline/ref/a70q-downstream.dts, `dtc -I fs /proc/device-tree`). Samsung moved several
 * firmware regions away from the Qualcomm defaults used by talos.dtsi (four of them would sit
 * inside Samsung's modem region), so those are overridden and Samsung's extra carve-outs added.
 */
/dts-v1/;

#include <dt-bindings/regulator/qcom,rpmh-regulator.h>
#include <dt-bindings/spmi/spmi.h>
#include <dt-bindings/firmware/qcom,scm.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include "talos.dtsi"
#include "pm6150.dtsi"
#include "pm6150l.dtsi"

/ {
	model = "Samsung Galaxy A70 (SM-A705F)";
	compatible = "samsung,a70q", "qcom,sm6150";
	chassis-type = "handset";

	/* Samsung's sboot picks the DTB by these (same values as the downstream DT) */
	qcom,msm-id = <355 0x0>;
	qcom,board-id = <0x22 0xd>;

	/* board clocks referenced by talos.dtsi (downstream: sleep-clk 0x7d00 = 32000 Hz) */
	clocks {
		sleep_clk: sleep-clk {
			compatible = "fixed-clock";
			clock-frequency = <32000>;
			#clock-cells = <0>;
		};

		xo_board_clk: xo-board-clk {
			compatible = "fixed-clock";
			clock-frequency = <38400000>;
			#clock-cells = <0>;
		};
	};

	chosen {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		/* continuous splash buffer left by the bootloader: 1080x2400 ARGB8888 */
		framebuffer@9c000000 {
			compatible = "simple-framebuffer";
			reg = <0x0 0x9c000000 0x0 (1080 * 2400 * 4)>;
			width = <1080>;
			height = <2400>;
			stride = <(1080 * 4)>;
			format = "a8r8g8b8";
		};
	};

	reserved-memory {
		/*
		 * Samsung KASLR info page written by the bootloader (downstream: removed-dma-pool, i.e.
		 * not kernel memory). It was the only downstream carve-out missing here, and the phone
		 * was reset by the secure side (PON POFF reason PS_HOLD, no kernel panic) ~7.5 s in, as
		 * memory use grew.
		 */
		kaslr_mem: kaslr@80001000 {
			reg = <0x0 0x80001000 0x0 0x1000>;
			no-map;
		};

		/* modem EFS shared buffer for rmtfs (downstream allocates it dynamically, 2 MiB) */
		rmtfs_mem: rmtfs@9e200000 {
			compatible = "qcom,rmtfs-mem";
			reg = <0x0 0x9e200000 0x0 0x200000>;
			no-map;
			qcom,client-id = <1>;
			qcom,vmid = <QCOM_SCM_VMID_MSS_MSA>;
		};

		hyp_mem: hyp@85700000 {
			reg = <0x0 0x85700000 0x0 0x600000>;
			no-map;
		};

		xbl_aop_mem: xbl-aop@85d00000 {
			reg = <0x0 0x85d00000 0x0 0x240000>;
			no-map;
		};

		sec_apps_mem: sec-apps@85fff000 {
			reg = <0x0 0x85fff000 0x0 0x1000>;
			no-map;
		};

		removed_mem: removed@86200000 {
			reg = <0x0 0x86200000 0x0 0x5600000>;
			no-map;
		};

		camera_mem: camera@8cb00000 {
			reg = <0x0 0x8cb00000 0x0 0x500000>;
			no-map;
		};

		modem_mem: modem@8d000000 {
			reg = <0x0 0x8d000000 0x0 0x8c00000>;
			no-map;
		};

		wlan_msa_mem: wlan-msa@96100000 {
			reg = <0x0 0x96100000 0x0 0x200000>;
			no-map;
		};

		ips_fw_mem: ips-fw@9a900000 {
			reg = <0x0 0x9a900000 0x0 0x10000>;
			no-map;
		};

		ipa_gsi_mem: ipa-gsi@9a910000 {
			reg = <0x0 0x9a910000 0x0 0x5000>;
			no-map;
		};

		cont_splash_mem: cont-splash@9c000000 {
			reg = <0x0 0x9c000000 0x0 0xf00000>;
			no-map;
		};

		dfps_data_mem: dfps-data@9cf00000 {
			reg = <0x0 0x9cf00000 0x0 0x100000>;
			no-map;
		};

		qseecom_mem: qseecom@9e400000 {
			reg = <0x0 0x9e400000 0x0 0x2400000>;
			no-map;
		};

		ss_plog_mem: ss-plog@a1100000 {
			reg = <0x0 0xa1100000 0x0 0x200000>;
			no-map;
		};

		/* same layout as the downstream ramoops node: the downstream kernel reads it back */
		ramoops@a1300000 {
			compatible = "ramoops";
			reg = <0x0 0xa1300000 0x0 0x100000>;
			record-size = <0x40000>;
			console-size = <0x40000>;
			ftrace-size = <0x40000>;
			pmsg-size = <0x40000>;
			/* also store the log on restart/poweroff (KMSG_DUMP_SHUTDOWN), read back by pmOS */
			max-reason = <4>;
		};

		sec_debug_mem: sec-debug@a1400000 {
			reg = <0x0 0xa1400000 0x0 0x800000>;
			no-map;
		};

		cdsp_sec_mem: cdsp-sec@a4000000 {
			reg = <0x0 0xa4000000 0x0 0xc00000>;
			no-map;
		};

		/* Samsung uH hypervisor / RKP / TIMA */
		tima_mem: tima@b0100000 {
			reg = <0x0 0xb0100000 0x0 0x100000>;
			no-map;
		};

		rkp_mem: rkp@b0200000 {
			reg = <0x0 0xb0200000 0x0 0x200000>;
			no-map;
		};

		uh_heap_mem: uh-heap@b0400000 {
			reg = <0x0 0xb0400000 0x0 0x1400000>;
			no-map;
		};

		modem_shared_mem: modem-shared@ba000000 {
			reg = <0x0 0xba000000 0x0 0x6000000>;
			no-map;
		};
	};
};

/* Qualcomm default carve-outs from talos.dtsi, moved by Samsung (values from the downstream DT) */
&pil_video_mem {
	reg = <0x0 0x95c00000 0x0 0x500000>;
};

&rproc_cdsp_mem {
	reg = <0x0 0x96300000 0x0 0x1e00000>;
};

&rproc_adsp_mem {
	reg = <0x0 0x98100000 0x0 0x2800000>;
};

&pil_gpu_mem {
	reg = <0x0 0x9a915000 0x0 0x2000>;
};

/*
 * Interconnect QoS: icc-rpmh writes the NoC QoS registers at probe (enabling the aggre1 AXI clocks
 * first); on this phone probing aggre1_noc hung the CPU (bring-up marker: last probe
 * "1700000.interconnect / qnoc-qcs615"), the registers are presumably locked by the secure
 * firmware. Without "reg" the driver skips QoS (skip_qos_config) and only votes bandwidth via RPMh.
 */
&aggre1_noc { /delete-property/ reg; };
&config_noc { /delete-property/ reg; };
&dc_noc { /delete-property/ reg; };
&gem_noc { /delete-property/ reg; };
&mmss_noc { /delete-property/ reg; };
&system_noc { /delete-property/ reg; };

/*
 * GPIOs owned by the secure world: the TLMM probe reads every pin and touching these made the phone
 * reset (bring-up marker: last probe "3100000.pinctrl / qcs615-tlmm", then reboot). Downstream DT:
 * fingerprint (etspi, handled in TrustZone) on spi@888000 = gpio0-3, eSE on spi@a88000 = gpio6-9.
 * The downstream kernel skips exactly these plus the Samsung Pay MST pins (msm_gpio_is_valid() in
 * pinctrl-msm.c: CONFIG_SENSORS_FP_SPI_GPIO 0-3, CONFIG_ESE_SPI_GPIO 6-9, MST_GPIO_D_DATA/EN 37-38).
 */
&tlmm {
	gpio-reserved-ranges = <0 4>, <6 4>, <37 2>;
};




/*
 * Milestone 1 keeps only the core (GCC, RPMh, interconnect, TLMM, PDC, SPMI, tsens, mailbox): every
 * device probed so far that the phone did not like reset or hung it, one Download Mode cycle each.
 * Disabled here (re-enabled per milestone): CoreSight debug blocks (usually locked on retail
 * phones), OSM L3 (same OSM block as cpufreq-hw), TRNG and QFPROM (often owned by TrustZone),
 * GPU/GMU/GPUCC, BWMON, LLCC, video/camera/display clock controllers and both SMMUs.
 */
/* efuse@780000 (QFPROM) re-enabled for milestone 2: holds the QUSB2 PHY hstx-trim cell */
&{/soc@0/stm@6002000} { status = "disabled"; };
&{/soc@0/tpda@6004000} { status = "disabled"; };
&{/soc@0/funnel@6005000} { status = "disabled"; };
&{/soc@0/cti@6010000} { status = "disabled"; };
&{/soc@0/cti@6011000} { status = "disabled"; };
&{/soc@0/cti@6012000} { status = "disabled"; };
&{/soc@0/cti@6013000} { status = "disabled"; };
&{/soc@0/cti@6014000} { status = "disabled"; };
&{/soc@0/cti@6015000} { status = "disabled"; };
&{/soc@0/cti@6016000} { status = "disabled"; };
&{/soc@0/cti@6017000} { status = "disabled"; };
&{/soc@0/cti@6018000} { status = "disabled"; };
&{/soc@0/cti@6019000} { status = "disabled"; };
&{/soc@0/cti@601a000} { status = "disabled"; };
&{/soc@0/cti@601b000} { status = "disabled"; };
&{/soc@0/cti@601c000} { status = "disabled"; };
&{/soc@0/cti@601d000} { status = "disabled"; };
&{/soc@0/cti@601e000} { status = "disabled"; };
&{/soc@0/cti@601f000} { status = "disabled"; };
&{/soc@0/funnel@6041000} { status = "disabled"; };
&{/soc@0/funnel@6042000} { status = "disabled"; };
&{/soc@0/funnel@6045000} { status = "disabled"; };
&{/soc@0/replicator@6046000} { status = "disabled"; };
&{/soc@0/tmc@6047000} { status = "disabled"; };
&{/soc@0/tmc@6048000} { status = "disabled"; };
&{/soc@0/cti@683b000} { status = "disabled"; };
&{/soc@0/tpdm@684c000} { status = "disabled"; };
&{/soc@0/tpdm@6850000} { status = "disabled"; };
&{/soc@0/tpdm@6860000} { status = "disabled"; };
&{/soc@0/funnel@6861000} { status = "disabled"; };
&{/soc@0/cti@6867000} { status = "disabled"; };
&{/soc@0/tpdm@69c0000} { status = "disabled"; };
&{/soc@0/funnel@69c3000} { status = "disabled"; };
&{/soc@0/cti@6a02000} { status = "disabled"; };
&{/soc@0/cti@6a03000} { status = "disabled"; };
&{/soc@0/cti@6a10000} { status = "disabled"; };
&{/soc@0/cti@6a11000} { status = "disabled"; };
&{/soc@0/funnel@6a05000} { status = "disabled"; };
&{/soc@0/tpda@6b01000} { status = "disabled"; };
&{/soc@0/cti@6b04000} { status = "disabled"; };
&{/soc@0/cti@6b05000} { status = "disabled"; };
&{/soc@0/cti@6b06000} { status = "disabled"; };
&{/soc@0/cti@6b07000} { status = "disabled"; };
&{/soc@0/funnel@6b08000} { status = "disabled"; };
&{/soc@0/tmc@6b09000} { status = "disabled"; };
&{/soc@0/replicator@6b0a000} { status = "disabled"; };
&{/soc@0/cti@6b21000} { status = "disabled"; };
&{/soc@0/tpdm@6b48000} { status = "disabled"; };
&{/soc@0/tpdm@6c28000} { status = "disabled"; };
&{/soc@0/cti@6c29000} { status = "disabled"; };
&{/soc@0/cti@6c2a000} { status = "disabled"; };
&{/soc@0/cti@7020000} { status = "disabled"; };
&{/soc@0/etm@7040000} { status = "disabled"; };
&{/soc@0/cti@7120000} { status = "disabled"; };
&{/soc@0/etm@7140000} { status = "disabled"; };
&{/soc@0/cti@7220000} { status = "disabled"; };
&{/soc@0/etm@7240000} { status = "disabled"; };
&{/soc@0/cti@7320000} { status = "disabled"; };
&{/soc@0/etm@7340000} { status = "disabled"; };
&{/soc@0/cti@7420000} { status = "disabled"; };
&{/soc@0/etm@7440000} { status = "disabled"; };
&{/soc@0/cti@7520000} { status = "disabled"; };
&{/soc@0/etm@7540000} { status = "disabled"; };
&{/soc@0/cti@7620000} { status = "disabled"; };
&{/soc@0/etm@7640000} { status = "disabled"; };
&{/soc@0/cti@7720000} { status = "disabled"; };
&{/soc@0/etm@7740000} { status = "disabled"; };
&{/soc@0/funnel@7800000} { status = "disabled"; };
&{/soc@0/funnel@7810000} { status = "disabled"; };
&{/soc@0/tpdm@7830000} { status = "disabled"; };
&{/soc@0/tpda@7832000} { status = "disabled"; };
&{/soc@0/tpdm@7860000} { status = "disabled"; };
&{/soc@0/tpda@7862000} { status = "disabled"; };
&{/soc@0/tpdm@78a0000} { status = "disabled"; };
&{/soc@0/tpdm@78b0000} { status = "disabled"; };
&{/soc@0/tpda@78c0000} { status = "disabled"; };
&{/soc@0/tpda@78d0000} { status = "disabled"; };
&{/soc@0/cti@78e0000} { status = "disabled"; };
&{/soc@0/cti@78f0000} { status = "disabled"; };
&{/soc@0/cti@7900000} { status = "disabled"; };
/* iommu@15000000 (apps_smmu) re-enabled for milestone 2: UFS DMA (stream 0x300) times out without it */




/*
 * Milestone 2: USB device mode (gadget) on the Type-C port, high speed only.
 * PHY supplies from the downstream qusb node (vdd = pm6150_l4, vdda18 = pm6150_l11,
 * vdda33 = pm6150_l17) and their voltage ranges.
 */
&apps_rsc {
	/*
	 * Without the PSCI CPU power domains (they made the firmware reset the phone) this waited
	 * forever for /psci/power-domain-cluster, holding back rpmhcc, GCC, regulators and USB.
	 * Without power-domains rpmh-rsc flushes its sleep/wake votes from CPU PM notifiers instead.
	 */
	/delete-property/ power-domains;

	regulators-0 {
		compatible = "qcom,pm6150-rpmh-regulators";
		qcom,pmic-id = "a";

		vreg_l4a: ldo4 {
			regulator-name = "vreg_l4a";
			regulator-min-microvolt = <875000>;
			regulator-max-microvolt = <975000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_l11a: ldo11 {
			regulator-name = "vreg_l11a";
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1890000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_l12a: ldo12 {
			regulator-name = "vreg_l12a";
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1950000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		/* touchscreen avdd (downstream pm6150_l18, 3.0 V) */
		vreg_l18a: ldo18 {
			regulator-name = "vreg_l18a";
			regulator-min-microvolt = <3000000>;
			regulator-max-microvolt = <3000000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		/* WiFi (WCN3990) cx/mx, downstream pm6150_l9 */
		vreg_l9a: ldo9 {
			regulator-name = "vreg_l9a";
			regulator-min-microvolt = <400000>;
			regulator-max-microvolt = <728000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_l17a: ldo17 {
			regulator-name = "vreg_l17a";
			regulator-min-microvolt = <3000000>;
			regulator-max-microvolt = <3230000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};
	};
};

&apps_rsc {
	regulators-1 {
		compatible = "qcom,pm6150l-rpmh-regulators";
		qcom,pmic-id = "c";

		/* WCN3990 supplies (downstream icnss: 1.8-xo = l1, 1.3-rfa = l2, 3.3-ch0 = l10) */
		vreg_l1c: ldo1 {
			regulator-name = "vreg_l1c";
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1900000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_l2c: ldo2 {
			regulator-name = "vreg_l2c";
			regulator-min-microvolt = <1304000>;
			regulator-max-microvolt = <1304000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_l10c: ldo10 {
			regulator-name = "vreg_l10c";
			regulator-min-microvolt = <3200000>;
			regulator-max-microvolt = <3312000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		/* UFS vcc (downstream pm6150l_l11) */
		vreg_l11c: ldo11 {
			regulator-name = "vreg_l11c";
			regulator-min-microvolt = <2950000>;
			regulator-max-microvolt = <3312000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};
	};
};

/*
 * UFS (supplies from the downstream ufshc/ufsphy nodes: vcc = pm6150l_l11, vccq2 = pm6150_l12,
 * PHY = pm6150_l4 / pm6150_l11).
 */
&ufs_mem_hc {
	vcc-supply = <&vreg_l11c>;
	vcc-max-microamp = <600000>;
	vccq2-supply = <&vreg_l12a>;
	vccq2-max-microamp = <600000>;

	status = "okay";
};

&ufs_mem_phy {
	vdda-phy-supply = <&vreg_l4a>;
	vdda-pll-supply = <&vreg_l11a>;

	status = "okay";
};

&usb_1_hsphy {
	vdd-supply = <&vreg_l4a>;
	vdda-pll-supply = <&vreg_l11a>;
	vdda-phy-dpdm-supply = <&vreg_l17a>;

	status = "okay";
};

&usb_1 {
	phys = <&usb_1_hsphy>;
	phy-names = "usb2-phy";
	maximum-speed = "high-speed";
	/* no USB3 PHY: clock the PIPE domain from UTMI (otherwise ep0 commands time out) */
	qcom,select-utmi-as-pipe-clk;
	dr_mode = "peripheral";

	status = "okay";
};

/*
 * Milestone 3: Adreno 612. Firmware from the pmOS rootfs (/lib/firmware: a630_sqe.fw, a612_rgmu.bin and
 * Samsung's signed zap shader a612_zap.mdt/.b0x).
 */
&gpu {
	status = "okay";
};

&gpu_zap_shader {
	firmware-name = "a612_zap.mdt";
};

&gmu {
	status = "okay";
};


/* PMIC peripherals: power key (pwrkey), volume down (RESIN), RTC; volume up = pm6150l GPIO 8 */
&pm6150_resin {
	linux,code = <KEY_VOLUMEDOWN>;
	status = "okay";
};

&pm6150_rtc {
	status = "okay";
};

&pm6150l_gpios {
	vol_up_n: vol-up-n-state {
		pins = "gpio8";
		function = "normal";
		input-enable;
		bias-pull-up;
	};
};

/ {
	gpio-keys {
		compatible = "gpio-keys";
		label = "gpio-keys";
		pinctrl-0 = <&vol_up_n>;
		pinctrl-names = "default";

		key-volume-up {
			label = "volume_up";
			gpios = <&pm6150l_gpios 8 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_VOLUMEUP>;
			debounce-interval = <15>;
			wakeup-source;
		};
	};
};

/* Touchscreen: Imagis IST4050 on QUP0 SE1 (downstream i2c@884000, address 0x50, irq GPIO 89, power GPIO 93) */
/* the SEs are in GPI mode (set by the firmware): geni-i2c needs the GPI DMA engine */
&gpi_dma0 {
	status = "okay";
};

&qupv3_id_0 {
	status = "okay";
};

&i2c1 {
	clock-frequency = <400000>;
	status = "okay";

	touchscreen@50 {
		compatible = "imagis,ist40xx";
		reg = <0x50>;
		interrupts-extended = <&tlmm 89 IRQ_TYPE_LEVEL_LOW>;
		power-gpios = <&tlmm 93 GPIO_ACTIVE_HIGH>;
		pinctrl-0 = <&ts_int>;
		pinctrl-names = "default";
		vdd-supply = <&vreg_l18a>;
		touchscreen-size-x = <1080>;
		touchscreen-size-y = <2400>;
	};
};

&tlmm {
	/* downstream tsp_int: no pull on the touchscreen interrupt line */
	ts_int: ts-int-state {
		pins = "gpio89";
		function = "gpio";
		bias-disable;
		input-enable;
	};
};

/*
 * Display clock controller off while the panel runs on the bootloader's framebuffer (simpledrm):
 * probing dispcc parks the display RCGs and the screen goes black (the compositor kept drawing,
 * so grim screenshots looked fine). Needed again with a real MDSS/DSI panel driver.
 */
&dispcc {
	status = "disabled";
};

/*
 * Modem (MPSS) and WiFi (WCN3990, firmware on the modem DSP). QCS615 has no modem, so these come
 * from sm8150.dtsi (same interrupt/mailbox numbers) and the downstream DT: smp2p smem 435/428,
 * IPC bit 14, IRQ SPI 451; glink SPI 449, IPC bit 12; PAS id 4; WLAN CE IRQs SPI 414-425, SID 0x1640.
 */
/ {
	smp2p-modem {
		compatible = "qcom,smp2p";
		qcom,smem = <435>, <428>;
		interrupts = <GIC_SPI 451 IRQ_TYPE_EDGE_RISING 0>;
		mboxes = <&apss_shared 14>;
		qcom,local-pid = <0>;
		qcom,remote-pid = <1>;

		modem_smp2p_out: master-kernel {
			qcom,entry-name = "master-kernel";
			#qcom,smem-state-cells = <1>;
		};

		modem_smp2p_in: slave-kernel {
			qcom,entry-name = "slave-kernel";
			interrupt-controller;
			#interrupt-cells = <2>;
		};
	};
};

&{/soc@0} {
	remoteproc_mpss: remoteproc@4080000 {
		compatible = "qcom,sm8150-mpss-pas";
		reg = <0x0 0x04080000 0x0 0x4040>;

		interrupts-extended = <&intc GIC_SPI 266 IRQ_TYPE_EDGE_RISING 0>,
				      <&modem_smp2p_in 0 IRQ_TYPE_EDGE_RISING>,
				      <&modem_smp2p_in 1 IRQ_TYPE_EDGE_RISING>,
				      <&modem_smp2p_in 2 IRQ_TYPE_EDGE_RISING>,
				      <&modem_smp2p_in 3 IRQ_TYPE_EDGE_RISING>,
				      <&modem_smp2p_in 7 IRQ_TYPE_EDGE_RISING>;
		interrupt-names = "wdog", "fatal", "ready", "handover",
				  "stop-ack", "shutdown-ack";

		clocks = <&rpmhcc RPMH_CXO_CLK>;
		clock-names = "xo";

		power-domains = <&rpmhpd RPMHPD_CX>,
				<&rpmhpd RPMHPD_MSS>;
		power-domain-names = "cx", "mss";

		memory-region = <&modem_mem>;
		qcom,qmp = <&aoss_qmp>;

		qcom,smem-states = <&modem_smp2p_out 0>;
		qcom,smem-state-names = "stop";

		glink-edge {
			interrupts = <GIC_SPI 449 IRQ_TYPE_EDGE_RISING 0>;
			label = "modem";
			qcom,remote-pid = <1>;
			mboxes = <&apss_shared 12>;
		};
	};

	wifi: wifi@18800000 {
		compatible = "qcom,wcn3990-wifi";
		reg = <0x0 0x18800000 0x0 0x800000>;
		reg-names = "membase";
		memory-region = <&wlan_msa_mem>;
		interrupts = <GIC_SPI 414 IRQ_TYPE_LEVEL_HIGH 0>,
			     <GIC_SPI 415 IRQ_TYPE_LEVEL_HIGH 0>,
			     <GIC_SPI 416 IRQ_TYPE_LEVEL_HIGH 0>,
			     <GIC_SPI 417 IRQ_TYPE_LEVEL_HIGH 0>,
			     <GIC_SPI 418 IRQ_TYPE_LEVEL_HIGH 0>,
			     <GIC_SPI 419 IRQ_TYPE_LEVEL_HIGH 0>,
			     <GIC_SPI 420 IRQ_TYPE_LEVEL_HIGH 0>,
			     <GIC_SPI 421 IRQ_TYPE_LEVEL_HIGH 0>,
			     <GIC_SPI 422 IRQ_TYPE_LEVEL_HIGH 0>,
			     <GIC_SPI 423 IRQ_TYPE_LEVEL_HIGH 0>,
			     <GIC_SPI 424 IRQ_TYPE_LEVEL_HIGH 0>,
			     <GIC_SPI 425 IRQ_TYPE_LEVEL_HIGH 0>;
		iommus = <&apps_smmu 0x1640 0x1>;
		vdd-0.8-cx-mx-supply = <&vreg_l9a>;
		vdd-1.8-xo-supply = <&vreg_l1c>;
		vdd-1.3-rfa-supply = <&vreg_l2c>;
		vdd-3.3-ch0-supply = <&vreg_l10c>;
		qcom,snoc-host-cap-8bit-quirk;
	};
};
