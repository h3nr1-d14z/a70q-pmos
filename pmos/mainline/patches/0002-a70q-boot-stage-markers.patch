diff -ruN a/arch/arm64/kernel/a70q-mark.c b/arch/arm64/kernel/a70q-mark.c
--- a/arch/arm64/kernel/a70q-mark.c	1970-01-01 00:00:00.000000000 +0000
+++ b/arch/arm64/kernel/a70q-mark.c	2026-11-15 09:49:10.129137443 +0000
@@ -0,0 +1,33 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * a70q bring-up without UART: paint a 40-line band of the bootloader splash framebuffer
+ * (0x9c000000, 1080 px ARGB8888, still scanned out) for each boot stage reached, below the green
+ * band painted at kernel entry (head.S). The last band visible tells where the boot stops.
+ */
+#include <linux/a70q_mark.h>
+#include <linux/io.h>
+#include <asm/early_ioremap.h>
+
+#define FB_BASE		0x9c000000UL
+#define FB_WIDTH	1080
+#define BAND_LINES	40
+#define BAND_TOP	200
+
+void a70q_mark(int stage, u32 argb, bool early)
+{
+	unsigned long off = (unsigned long)(BAND_TOP + stage * BAND_LINES) * FB_WIDTH * 4;
+	size_t len = BAND_LINES * FB_WIDTH * 4;
+	u32 __iomem *p;
+	size_t i;
+
+	p = early ? early_ioremap(FB_BASE + off, len) : ioremap(FB_BASE + off, len);
+	if (!p)
+		return;
+	for (i = 0; i < len / 4; i++)
+		writel_relaxed(argb, p + i);
+	wmb();
+	if (early)
+		early_iounmap(p, len);
+	else
+		iounmap(p);
+}
