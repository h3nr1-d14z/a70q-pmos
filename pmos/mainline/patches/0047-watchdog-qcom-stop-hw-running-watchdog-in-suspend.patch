--- a/drivers/watchdog/qcom-wdt.c	2026-11-22 22:41:22
+++ b/drivers/watchdog/qcom-wdt.c	2026-11-22 22:41:23
@@ -362,7 +362,12 @@
 {
 	struct qcom_wdt *wdt = dev_get_drvdata(dev);
 
-	if (watchdog_active(&wdt->wdd))
+	/*
+	 * Also when the bootloader left it running and only the watchdog core pings it
+	 * (WDOG_HW_RUNNING, no userspace user): its ping timer stops during suspend, so the
+	 * watchdog barked and bit (reset) after an s2idle wakeup.
+	 */
+	if (watchdog_active(&wdt->wdd) || watchdog_hw_running(&wdt->wdd))
 		qcom_wdt_stop(&wdt->wdd);
 
 	return 0;
@@ -372,7 +377,12 @@
 {
 	struct qcom_wdt *wdt = dev_get_drvdata(dev);
 
-	if (watchdog_active(&wdt->wdd))
+	/*
+	 * Also when the bootloader left it running and only the watchdog core pings it
+	 * (WDOG_HW_RUNNING, no userspace user): its ping timer stops during suspend, so the
+	 * watchdog barked and bit (reset) after an s2idle wakeup.
+	 */
+	if (watchdog_active(&wdt->wdd) || watchdog_hw_running(&wdt->wdd))
 		qcom_wdt_start(&wdt->wdd);
 
