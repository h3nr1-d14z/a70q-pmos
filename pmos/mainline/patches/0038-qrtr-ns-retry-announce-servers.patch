--- a/net/qrtr/ns.c	2026-11-19 03:36:41.719139223 +0000
+++ b/net/qrtr/ns.c	2026-11-19 03:36:41.719139223 +0000
@@ -5,6 +5,7 @@
  * Copyright (c) 2020, Linaro Ltd.
