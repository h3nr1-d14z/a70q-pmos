--- a/sound/soc/qcom/qdsp6/q6dsp-lpass-clocks.c	2026-11-18 09:21:00.661686658 +0000
+++ b/sound/soc/qcom/qdsp6/q6dsp-lpass-clocks.c	2026-11-18 09:21:00.670944089 +0000
@@ -180,6 +180,21 @@
 
 	dev_set_drvdata(dev, cc);
 
+	/* a70q bring-up: which LPASS codec clock ids does this ADSP accept? */
+	if (desc->lpass_set_clk) {
+		static const u32 ids[] = { 0x309, 0x30a, 0x30b, 0x30c, 0x30d, 0x30e, 0x30f };
+		static const u32 rates[] = { 19200000, 9600000 };
+		int k, r;
+
+		for (k = 0; k < ARRAY_SIZE(ids); k++)
+			for (r = 0; r < ARRAY_SIZE(rates); r++) {
+				ret = desc->lpass_set_clk(dev, ids[k], 1, 0, rates[r]);
+				dev_info(dev, "a70q clk test id 0x%x rate %u: %d\n", ids[k], rates[r], ret);
+				if (!ret)
+					desc->lpass_set_clk(dev, ids[k], 1, 0, 0);
+			}
+	}
+
 	return 0;
 }
 EXPORT_SYMBOL_GPL(q6dsp_clock_dev_probe);
