#!/bin/busybox sh
# a70q mainline test initramfs (milestone 2): bring up a USB ECM gadget with a DHCP server and a
# telnet shell on 172.16.42.1:23 (pmOS uses the same address with SSH on :22, so port 23 tells the
# Mac that the mainline kernel is up), keep the kernel log on screen, reboot after STAY seconds.
# The kernel itself switches the next boot back to pmOS (patch 0010/0011) and runs the watchdog.
/bin/busybox --install -s /bin
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev 2>/dev/null
mkdir -p /dev/pts /tmp /var/lib/misc /etc
mount -t devpts devpts /dev/pts
mount -t configfs configfs /sys/kernel/config
STAY=600
msg() { echo "A70Q-MAINLINE: $*" > /dev/kmsg; echo "A70Q-MAINLINE: $*" > /dev/tty0 2>/dev/null; }
msg "initramfs reached, kernel $(uname -r)"

# Self-heal: the Samsung bootloader keeps booting RECOVERY (this kernel) after an abnormal reset.
# A boot counter in the last 4 KiB of the RECOVERY partition counts boots that did not reach a
# healthy state; at 3 the downstream pmOS kernel (BOOT) is copied over RECOVERY and the phone
# reboots, so even a recovery loop ends in pmOS. Reset to 0 once telnet is up (initramfs mode)
# or after 3 minutes of running pmOS (rootfs mode).
part() { for b in /sys/class/block/*; do grep -q "^PARTNAME=$1\$" $b/uevent 2>/dev/null && echo /dev/${b##*/}; done; }
RECOV=$(part recovery); BOOTP=$(part boot)
if [ -n "$RECOV" ] && [ -n "$BOOTP" ]; then
	last=$(( $(cat /sys/class/block/${RECOV##*/}/size) / 8 - 1 ))
	tries=$(dd if=$RECOV bs=4096 skip=$last count=1 2>/dev/null | head -c 12)
	case "$tries" in A70QTRIES=[0-9]*) n=${tries#A70QTRIES=}; n=${n%%[!0-9]*} ;; *) n=0 ;; esac
	setcount() { printf 'A70QTRIES=%d\n' $1 | dd of=$RECOV bs=4096 seek=$last count=1 conv=sync,notrunc 2>/dev/null; sync; }
	msg "boot attempts without a healthy state: $n"
	if [ "$n" -ge 3 ]; then
		msg "recovery loop: copying BOOT ($BOOTP) to RECOVERY ($RECOV) and rebooting"
		dd if=$BOOTP of=$RECOV bs=4M conv=fsync 2>/dev/null
		sync
		echo b > /proc/sysrq-trigger
	fi
	setcount $((n + 1))
fi

gadget() {
	g=/sys/kernel/config/usb_gadget/a70q
	mkdir -p $g || return 1
	echo 0x18d1 > $g/idVendor
	echo 0xd001 > $g/idProduct
	mkdir -p $g/strings/0x409
	echo "Samsung" > $g/strings/0x409/manufacturer
	echo "Galaxy A70 mainline" > $g/strings/0x409/product
	echo "a70q-mainline" > $g/strings/0x409/serialnumber
	mkdir -p $g/functions/ecm.usb0 $g/configs/c.1/strings/0x409
	echo "ECM" > $g/configs/c.1/strings/0x409/configuration
	ln -s $g/functions/ecm.usb0 $g/configs/c.1/ 2>/dev/null
	udc=""
	for i in $(seq 1 30); do
		udc=$(ls /sys/class/udc 2>/dev/null | head -1)
		[ -n "$udc" ] && break
		sleep 1
	done
	[ -n "$udc" ] || { msg "no UDC: $(ls /sys/bus/platform/drivers/dwc3* 2>&1 | tr '\n' ' ')"; return 1; }
	echo "$udc" > $g/UDC && msg "gadget bound to $udc"
}

if gadget; then
	for i in $(seq 1 10); do ip link show usb0 >/dev/null 2>&1 && break; sleep 1; done
	ip addr add 172.16.42.1/24 dev usb0
	ip link set usb0 up
	cat > /etc/udhcpd.conf <<EOF
start 172.16.42.2
end 172.16.42.2
interface usb0
option subnet 255.255.255.0
lease_file /var/lib/misc/udhcpd.leases
EOF
	touch /var/lib/misc/udhcpd.leases
	busybox-extras udhcpd /etc/udhcpd.conf
	msg "usb0 172.16.42.1"
fi

# a70q.rootfs on the cmdline: boot the installed pmOS (userdata = disk image, p2 = pmOS_root)
if grep -q a70q.rootfs /proc/cmdline; then
	dev=""
	for b in /sys/class/block/*; do
		grep -q '^PARTNAME=userdata$' $b/uevent 2>/dev/null && dev=/dev/${b##*/}
	done
	msg "userdata = ${dev:-not found}"
	# The image's GPT uses 4096-byte sectors (UFS logical block size) but a loop device reads it with
	# 512-byte sectors and finds no partitions: map p1/p2 with byte offsets instead.
	poff() { fdisk -l -b 4096 "$dev" 2>/dev/null | awk -v n=$1 '$1==n {print $2 * 4096}'; }
	root_off=$(poff 2); boot_off=$(poff 1)
	msg "pmOS root at byte $root_off, boot at $boot_off"
	if [ -n "$dev" ] && [ -n "$root_off" ] && losetup -o "$root_off" /dev/loop1 "$dev"; then
		[ -n "$boot_off" ] && losetup -o "$boot_off" /dev/loop2 "$dev"
		mkdir -p /newroot
		if mount -t ext4 /dev/loop1 /newroot && [ -x /newroot/sbin/init ]; then
			# safety net: whatever happens in pmOS, reset after 15 min (the fd survives switch_root)
			( exec 3>/proc/sysrq-trigger; sleep 900; echo s >&3; sleep 2; echo b >&3 ) &
			# healthy after 3 minutes in pmOS: reset the boot counter (fd kept across switch_root)
			[ -n "$RECOV" ] && ( exec 4<>$RECOV; sleep 180; printf 'A70QTRIES=0\n' | dd bs=4096 seek=$last count=1 conv=sync,notrunc 1>&4 2>/dev/null; sync ) &
			msg "switch_root into pmOS ($dev, loop1)"
			mount --move /proc /newroot/proc
			mount --move /sys /newroot/sys
			mount --move /dev /newroot/dev
			exec switch_root /newroot /sbin/init
		fi
		msg "pmOS root not mountable"
	fi
fi

# telnet only when staying in the initramfs (in rootfs mode port 23 means: switch_root failed)
busybox-extras telnetd -l /bin/sh -p 23 && msg "telnet :23" && [ -n "$RECOV" ] && setcount 0
msg "staying $STAY s"
sleep $STAY
msg "rebooting"
sync
echo b > /proc/sysrq-trigger
