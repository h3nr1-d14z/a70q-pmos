# a70q mainline fragment on top of arm64 defconfig (milestone 1: boot, simplefb console, ramoops)
CONFIG_LOCALVERSION="-a70q"
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_PANIC_TIMEOUT=10
CONFIG_MAGIC_SYSRQ=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
# The phone reset with no probe running (last initcall: ip_auto_config): the bootloader leaves the
# APSS watchdog running and nothing pets it. Built in, qcom-wdt finds it enabled and pets it
# (WATCHDOG_HANDLE_BOOT_ENABLED) until userspace takes over.
CONFIG_QCOM_WDT=y
CONFIG_WATCHDOG_HANDLE_BOOT_ENABLED=y
# no network autoconfig at boot (it can wait for devices)
# CONFIG_IP_PNP is not set
# The external reset (PS_HOLD, no panic) follows the probe of the PSCI CPU power domains
# (power-domain-cpuN, which also switch PSCI to OS-initiated mode) even with cpuidle.off=1:
# leave PSCI cpuidle/domains out for milestone 1.
# CONFIG_ARM_PSCI_CPUIDLE is not set
# CONFIG_ARM_PSCI_CPUIDLE_DOMAIN is not set
# milestone 2: USB gadget (ECM) built in, the test initramfs has no modules
CONFIG_PHY_QCOM_QUSB2=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_F_ECM=y
CONFIG_USB_F_NCM=y
# milestone 2: UFS built in
CONFIG_SCSI_UFS_QCOM=y
CONFIG_PHY_QCOM_QMP=y
CONFIG_PHY_QCOM_QMP_UFS=y
CONFIG_QCOM_INLINE_CRYPTO_ENGINE=y
