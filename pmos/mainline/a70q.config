# a70q mainline fragment on top of arm64 defconfig (milestone 1: boot, simplefb console, ramoops)
CONFIG_LOCALVERSION="-a70q"
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_PANIC_TIMEOUT=10
CONFIG_MAGIC_SYSRQ=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
# The phone reset with no probe running (last initcall: ip_auto_config): the bootloader leaves the
# APSS watchdog running and nothing pets it. Built in, qcom-wdt finds it enabled and pets it
# (WATCHDOG_HANDLE_BOOT_ENABLED) until userspace takes over.
CONFIG_QCOM_WDT=y
CONFIG_WATCHDOG_HANDLE_BOOT_ENABLED=y
# no network autoconfig at boot (it can wait for devices)
# CONFIG_IP_PNP is not set
# The external reset (PS_HOLD, no panic) follows the probe of the PSCI CPU power domains
# (power-domain-cpuN, which also switch PSCI to OS-initiated mode) even with cpuidle.off=1:
# leave PSCI cpuidle/domains out for milestone 1.
# CONFIG_ARM_PSCI_CPUIDLE is not set
# CONFIG_ARM_PSCI_CPUIDLE_DOMAIN is not set
# milestone 2: USB gadget (ECM) built in, the test initramfs has no modules
CONFIG_PHY_QCOM_QUSB2=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_F_ECM=y
CONFIG_USB_F_NCM=y
# milestone 2: UFS built in
CONFIG_SCSI_UFS_QCOM=y
CONFIG_PHY_QCOM_QMP=y
CONFIG_PHY_QCOM_QMP_UFS=y
CONFIG_QCOM_INLINE_CRYPTO_ENGINE=y
CONFIG_INTERCONNECT_QCOM_OSM_L3=y
# milestone 3: DRM/msm/simpledrm built in (GPU tests from the initramfs, display from early boot)
CONFIG_DRM=y
CONFIG_DRM_MSM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_SYSFB_HELPER=y
CONFIG_QCOM_LLCC=y
CONFIG_QCOM_OCMEM=y
CONFIG_QCOM_AOSS_QMP=y
CONFIG_QCOM_SMEM=y
CONFIG_QCOM_MDT_LOADER=y
CONFIG_QCOM_UBWC_CONFIG=y
# clock controllers built in (GPU/display probe without modules)
CONFIG_QCS_GPUCC_615=y
CONFIG_QCS_DISPCC_615=y
CONFIG_QCS_VIDEOCC_615=y
CONFIG_QCS_CAMCC_615=y
# touchscreen (patch 0016) + QUP I2C built in
CONFIG_TOUCHSCREEN_IST40XX=y
CONFIG_I2C_QCOM_GENI=y
CONFIG_QCOM_GENI_SE=y
CONFIG_QCOM_GPI_DMA=y
# SCM buffers without SHM bridge (Samsung TZ/hyp: assign_mem left a CPU stuck in the secure world)
CONFIG_QCOM_TZMEM_MODE_GENERIC=y
# CONFIG_QCOM_TZMEM_MODE_SHMBRIDGE is not set
CONFIG_ATH10K_DEBUG=y
CONFIG_DRM_PANEL_SAMSUNG_S6E3FC2_AMS670TA01=y
CONFIG_DRM_MSM_DSI=y
CONFIG_DRM_MSM_DSI_14NM_PHY=y
CONFIG_DRM_MSM_DPU=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BATTERY_A70Q=y
CONFIG_PM_DEBUG=y
CONFIG_PM_ADVANCED_DEBUG=y
CONFIG_PM_SLEEP_DEBUG=y
CONFIG_DYNAMIC_DEBUG=y
CONFIG_PINCTRL_SM6150_LPASS_LPI=m
CONFIG_REGULATOR_S2MPB03=m
CONFIG_A70Q_CAMPOWER=m
CONFIG_VIDEO_S5KGD1=m
CONFIG_DMABUF_HEAPS=y
CONFIG_DMABUF_HEAPS_SYSTEM=y
CONFIG_UDMABUF=y
CONFIG_VIDEO_S5K4HA=m
CONFIG_VIDEO_FP5529=m
