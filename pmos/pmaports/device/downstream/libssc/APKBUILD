790f0b20b8c47d69ed173a962653905d19b39449247547e7adb15c068fb205356c2497591c4afb16973992571151ea10393d9c1bb6dc17eb8dc154a5b4ccf59a  libssc-0001-proximity-samsung-far-2-no-abort.patch
"
