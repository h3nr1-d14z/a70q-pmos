# Reference: <https://postmarketos.org/devicepkg>
maintainer="a70q pmOS port <noreply@example.org>"
pkgname=device-samsung-a70q
pkgdesc="Samsung Galaxy A70"
pkgver=1
pkgrel=33
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
depends="
	a70q-qcom-userspace
	android-tools-mkbootimg
	iw
	rmtfs
	wpa_supplicant
	bluez-obexd
	hexagonrpcd
	iio-sensor-proxy
	linux-samsung-a70q
	mesa-vulkan-freedreno-kgsl
	postmarketos-base
"
makedepends="devicepkg-dev"
install="$pkgname.post-install"
source="
	deviceinfo
	unudhcpd.ecm0.confd
	a70q-modem-up
	a70q-modem.initd
	a70q-wlroots.sh
	50-a70q.nm.conf
	sxmo_deviceprofile.sh
	60-a70q-gpu.rules
	ucm/a70q.conf
	ucm/HiFi.conf
	50-a70q-elogind.conf
	wlopm-retry.sh
	sxmo_hook_postwake.sh
	50-a70q-sway.conf
	sxmo_soundmonitor.sh
	sxmo_soundmonitor.service
	sxmo_vibrate.sh
	sxmo_flashtoggle.sh
	61-a70q-feedback.rules
	sxmo_brightness.sh
	brightnessctl-shim.sh
	51-a70q-alsa.conf
	a70q-obexd.service
	80-a70q-ssc.rules
	90-a70q-automount.rules
	a70q-automount
	a70q-statusbar.py
	sxmo_dmenu_back.sh
	a70q-autobrightness.py
	a70q-autobrightness.service
	sxmo_hook_start.sh
	sxmo_hook_contextmenu.sh
	a70q-dunstrc
	a70q-session.sh
	a70q-gtk3-settings.ini
"
options="!archcheck !check"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname
	install -Dm644 "$srcdir"/unudhcpd.ecm0.confd "$pkgdir"/etc/conf.d/unudhcpd.ecm0
	# ship the service instance + boot runlevel link directly (post-install may run
	# before postmarketos-base-openrc provides /etc/init.d/unudhcpd)
	mkdir -p "$pkgdir"/etc/init.d "$pkgdir"/etc/runlevels/boot
	ln -s unudhcpd "$pkgdir"/etc/init.d/unudhcpd.ecm0
	ln -s /etc/init.d/unudhcpd.ecm0 "$pkgdir"/etc/runlevels/boot/unudhcpd.ecm0
	install -Dm755 "$srcdir"/a70q-modem-up "$pkgdir"/usr/libexec/a70q/a70q-modem-up
	install -Dm755 "$srcdir"/a70q-modem.initd "$pkgdir"/etc/init.d/a70q-modem
	mkdir -p "$pkgdir"/etc/runlevels/default
	ln -s /etc/init.d/a70q-modem "$pkgdir"/etc/runlevels/default/a70q-modem
	install -Dm644 "$srcdir"/a70q-wlroots.sh "$pkgdir"/etc/profile.d/a70q-wlroots.sh
	install -Dm644 "$srcdir"/50-a70q.nm.conf "$pkgdir"/etc/NetworkManager/conf.d/50-a70q.conf
	install -Dm755 "$srcdir"/sxmo_deviceprofile.sh "$pkgdir"/usr/bin/sxmo_deviceprofile_qcom,sm6150p-idp.sh
	install -Dm644 "$srcdir"/60-a70q-gpu.rules "$pkgdir"/usr/lib/udev/rules.d/60-a70q-gpu.rules
	# ALSA UCM for the q6 card (driver name is truncated to "sm6150-idp-snd-")
	install -Dm644 "$srcdir"/a70q.conf "$pkgdir"/usr/share/alsa/ucm2/Samsung/a70q/a70q.conf
	install -Dm644 "$srcdir"/HiFi.conf "$pkgdir"/usr/share/alsa/ucm2/Samsung/a70q/HiFi.conf
	install -Dm755 "$srcdir"/wlopm-retry.sh "$pkgdir"/usr/share/a70q/sxmo/default_hooks/wlopm
	install -Dm755 "$srcdir"/sxmo_hook_postwake.sh "$pkgdir"/usr/share/a70q/sxmo/default_hooks/sxmo_hook_postwake.sh
	# vibrator + torch for Sxmo (replacements found first in Sxmo's PATH, see deviceprofile)
	install -Dm755 "$srcdir"/sxmo_vibrate.sh "$pkgdir"/usr/share/a70q/sxmo/default_hooks/sxmo_vibrate
	install -Dm755 "$srcdir"/sxmo_flashtoggle.sh "$pkgdir"/usr/share/a70q/sxmo/default_hooks/sxmo_flashtoggle.sh
	install -Dm644 "$srcdir"/61-a70q-feedback.rules "$pkgdir"/usr/lib/udev/rules.d/61-a70q-feedback.rules
	# brightness: point Sxmo's brightnessctl calls at the AMOLED panel backlight
	install -Dm755 "$srcdir"/sxmo_brightness.sh "$pkgdir"/usr/share/a70q/sxmo/default_hooks/sxmo_brightness.sh
	install -Dm755 "$srcdir"/brightnessctl-shim.sh "$pkgdir"/usr/share/a70q/brightnessctl-shim/brightnessctl
	# PipeWire: larger quantum for the q6 card (xruns at 512 frames)
	install -Dm644 "$srcdir"/51-a70q-alsa.conf "$pkgdir"/usr/share/wireplumber/wireplumber.conf.d/51-a70q-alsa.conf
	# sensors (SSC via libssc in iio-sensor-proxy)
	install -Dm644 "$srcdir"/80-a70q-ssc.rules "$pkgdir"/usr/lib/udev/rules.d/80-a70q-ssc.rules
	# microSD / USB storage auto-mount at /media/<label>
	install -Dm644 "$srcdir"/90-a70q-automount.rules "$pkgdir"/usr/lib/udev/rules.d/90-a70q-automount.rules
	install -Dm755 "$srcdir"/a70q-automount "$pkgdir"/usr/libexec/a70q/a70q-automount
	# clickable status bar (status_command in 50-a70q-sway.conf) and "Back" in Sxmo menus
	install -Dm755 "$srcdir"/a70q-statusbar.py "$pkgdir"/usr/libexec/a70q/a70q-statusbar.py
	install -Dm755 "$srcdir"/sxmo_dmenu_back.sh "$pkgdir"/usr/share/a70q/sxmo/default_hooks/sxmo_dmenu.sh
	# adaptive brightness (Config menu entry replaced in the context menu hook, started by the start hook)
	install -Dm755 "$srcdir"/a70q-autobrightness.py "$pkgdir"/usr/libexec/a70q/a70q-autobrightness
	install -Dm644 "$srcdir"/a70q-autobrightness.service "$pkgdir"/usr/share/superd/services/a70q-autobrightness.service
	install -Dm755 "$srcdir"/sxmo_hook_start.sh "$pkgdir"/usr/share/a70q/sxmo/default_hooks/sxmo_hook_start.sh
	install -Dm755 "$srcdir"/sxmo_hook_contextmenu.sh "$pkgdir"/usr/share/a70q/sxmo/default_hooks/sxmo_hook_contextmenu.sh
	# look: notifications like the menus, dark GTK/libadwaita; session env (WebKit sandbox, XDG dirs)
	install -Dm644 "$srcdir"/a70q-dunstrc "$pkgdir"/etc/xdg/dunst/dunstrc
	install -Dm644 "$srcdir"/a70q-gtk3-settings.ini "$pkgdir"/etc/gtk-3.0/settings.ini
	install -Dm644 "$srcdir"/a70q-session.sh "$pkgdir"/etc/profile.d/a70q-session.sh
	# Bluetooth file receive (OBEX) in the user session
	install -Dm644 "$srcdir"/a70q-obexd.service "$pkgdir"/usr/share/superd/services/a70q-obexd.service
	# Sxmo status bar refresh on headphone plug/unplug (superd reads /etc/superd/services first)
	install -Dm755 "$srcdir"/sxmo_soundmonitor.sh "$pkgdir"/usr/share/a70q/sxmo/sxmo_soundmonitor.sh
	install -Dm644 "$srcdir"/sxmo_soundmonitor.service "$pkgdir"/etc/superd/services/sxmo_soundmonitor.service
	install -Dm644 "$srcdir"/50-a70q-sway.conf "$pkgdir"/etc/sway/config.d/50-a70q.conf
	install -Dm644 "$srcdir"/50-a70q-elogind.conf "$pkgdir"/etc/elogind/logind.conf.d/50-a70q.conf
	mkdir -p "$pkgdir"/usr/share/alsa/ucm2/conf.d/sm6150-idp-snd-
	ln -s ../../Samsung/a70q/a70q.conf \
		"$pkgdir"/usr/share/alsa/ucm2/conf.d/sm6150-idp-snd-/sm6150-idp-snd-card.conf
}

