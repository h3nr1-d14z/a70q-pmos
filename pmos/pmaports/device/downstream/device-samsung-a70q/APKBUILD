pkgname=device-samsung-a70q
pkgdesc="Samsung Galaxy A70"
pkgver=1
pkgrel=45
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
depends="
	a70q-qcom-userspace
	android-tools-mkbootimg
	iw
	rmtfs
	wpa_supplicant
	bluez-obexd
	dconf
	hexagonrpcd
	iio-sensor-proxy
	linux-samsung-a70q
	mesa-vulkan-freedreno-kgsl
	postmarketos-base
"
makedepends="devicepkg-dev"
install="$pkgname.post-install"
source="
	deviceinfo
	unudhcpd.ecm0.confd
	a70q-modem-up
	a70q-modem.initd
	a70q-wlroots.sh
	50-a70q.nm.conf
	sxmo_deviceprofile.sh
	60-a70q-gpu.rules
	ucm/a70q.conf
	ucm/HiFi.conf
	50-a70q-elogind.conf
	wlopm-retry.sh
	sxmo_hook_postwake.sh
	50-a70q-sway.conf
	sxmo_soundmonitor.sh
	sxmo_soundmonitor.service
	sxmo_vibrate.sh
	sxmo_flashtoggle.sh
	61-a70q-feedback.rules
	sxmo_brightness.sh
	brightnessctl-shim.sh
	51-a70q-alsa.conf
	a70q-obexd.service
	80-a70q-ssc.rules
	90-a70q-automount.rules
	a70q-automount
	a70q-statusbar.py
	sxmo_dmenu_back.sh
	a70q-autobrightness.py
