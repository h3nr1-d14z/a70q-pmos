# Reference: <https://postmarketos.org/devicepkg>
maintainer="a70q pmOS port <noreply@example.org>"
pkgname=device-samsung-a70q
pkgdesc="Samsung Galaxy A70"
pkgver=1
pkgrel=16
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
depends="
	a70q-qcom-userspace
	android-tools-mkbootimg
	iw
	rmtfs
	wpa_supplicant
	linux-samsung-a70q
	mesa-vulkan-freedreno-kgsl
	postmarketos-base
"
makedepends="devicepkg-dev"
install="$pkgname.post-install"
source="
	deviceinfo
	unudhcpd.ecm0.confd
	a70q-modem-up
	a70q-modem.initd
	a70q-wlroots.sh
	50-a70q.nm.conf
	sxmo_deviceprofile.sh
	60-a70q-gpu.rules
	ucm/a70q.conf
	ucm/HiFi.conf
	50-a70q-elogind.conf
	wlopm-retry.sh
	sxmo_hook_postwake.sh
"
options="!archcheck !check"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname
	install -Dm644 "$srcdir"/unudhcpd.ecm0.confd "$pkgdir"/etc/conf.d/unudhcpd.ecm0
	# ship the service instance + boot runlevel link directly (post-install may run
	# before postmarketos-base-openrc provides /etc/init.d/unudhcpd)
	mkdir -p "$pkgdir"/etc/init.d "$pkgdir"/etc/runlevels/boot
	ln -s unudhcpd "$pkgdir"/etc/init.d/unudhcpd.ecm0
	ln -s /etc/init.d/unudhcpd.ecm0 "$pkgdir"/etc/runlevels/boot/unudhcpd.ecm0
	install -Dm755 "$srcdir"/a70q-modem-up "$pkgdir"/usr/libexec/a70q/a70q-modem-up
	install -Dm755 "$srcdir"/a70q-modem.initd "$pkgdir"/etc/init.d/a70q-modem
	mkdir -p "$pkgdir"/etc/runlevels/default
	ln -s /etc/init.d/a70q-modem "$pkgdir"/etc/runlevels/default/a70q-modem
	install -Dm644 "$srcdir"/a70q-wlroots.sh "$pkgdir"/etc/profile.d/a70q-wlroots.sh
	install -Dm644 "$srcdir"/50-a70q.nm.conf "$pkgdir"/etc/NetworkManager/conf.d/50-a70q.conf
	install -Dm755 "$srcdir"/sxmo_deviceprofile.sh "$pkgdir"/usr/bin/sxmo_deviceprofile_qcom,sm6150p-idp.sh
	install -Dm644 "$srcdir"/60-a70q-gpu.rules "$pkgdir"/usr/lib/udev/rules.d/60-a70q-gpu.rules
	# ALSA UCM for the q6 card (driver name is truncated to "sm6150-idp-snd-")
	install -Dm644 "$srcdir"/a70q.conf "$pkgdir"/usr/share/alsa/ucm2/Samsung/a70q/a70q.conf
	install -Dm644 "$srcdir"/HiFi.conf "$pkgdir"/usr/share/alsa/ucm2/Samsung/a70q/HiFi.conf
	install -Dm755 "$srcdir"/wlopm-retry.sh "$pkgdir"/usr/share/a70q/sxmo/default_hooks/wlopm
	install -Dm755 "$srcdir"/sxmo_hook_postwake.sh "$pkgdir"/usr/share/a70q/sxmo/default_hooks/sxmo_hook_postwake.sh
	install -Dm644 "$srcdir"/50-a70q-elogind.conf "$pkgdir"/etc/elogind/logind.conf.d/50-a70q.conf
	mkdir -p "$pkgdir"/usr/share/alsa/ucm2/conf.d/sm6150-idp-snd-
	ln -s ../../Samsung/a70q/a70q.conf \
		"$pkgdir"/usr/share/alsa/ucm2/conf.d/sm6150-idp-snd-/sm6150-idp-snd-card.conf
}

