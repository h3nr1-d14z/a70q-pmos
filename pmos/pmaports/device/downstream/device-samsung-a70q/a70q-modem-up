#!/bin/sh
# a70q (SM6150, downstream 4.14): start Qualcomm remote-proc userspace and boot the modem
# so WLAN (WCN3990, firmware on the modem DSP) comes up. EFS is accessed READ-ONLY (rmtfs -r).
# Order matters: qrtr-ns must own node address 1 before any service publishes.
FW=/vendor/firmware_mnt/image
FWM=/vendor/firmware-modem/image
log() { echo "[a70q-modem] $*"; }
part() { blkid -t PARTLABEL="$1" -o device; }

grep -q " /sys/kernel/debug " /proc/mounts || mount -t debugfs none /sys/kernel/debug
mkdir -p /var/log
for s in /sys/bus/msm_subsys/devices/*; do echo RELATED > "$s/restart_level"; done
# the LOS cmdline boots with lpm_levels.sleep_disabled=1 and Android's init re-enables the
# low-power modes after boot; without this, CPU idle stays shallow and suspend cannot work
echo 0 > /sys/module/lpm_levels/parameters/sleep_disabled 2>/dev/null
mkdir -p /vendor/firmware_mnt /vendor/firmware-modem
grep -q " /vendor/firmware_mnt " /proc/mounts || mount -o ro "$(part apnhlos)" /vendor/firmware_mnt
grep -q " /vendor/firmware-modem " /proc/mounts || mount -o ro "$(part modem)" /vendor/firmware-modem
mkdir -p /dev/disk/by-partlabel /lib/firmware
for p in modemst1 modemst2 fsc fsg; do ln -sf "$(part $p)" /dev/disk/by-partlabel/$p; done
for f in "$FWM"/*; do ln -sf "$f" /lib/firmware/; done        # modem.mdt etc. for PIL
[ -e /dev/qcom_rmtfs_uio1 ] || ln -sf /dev/uio0 /dev/qcom_rmtfs_uio1   # uio0 name=rmtfs

# Firmware from the vendor partition (copied once into the rootfs):
#  - WLAN: WCNSS_qcom_cfg.ini for qcacld
#  - GPU (Adreno 612, kgsl): SQE + RGMU microcode, requested on first open of /dev/kgsl-3d0
#    (the zap shader a612_zap.* lives on apnhlos and is linked below)
mkdir -p /lib/firmware/wlan/qca_cld
for f in "$FW"/a612_zap.*; do ln -sf "$f" /lib/firmware/; done
VEND=$(part vendor)
if { [ ! -e /lib/firmware/wlan/qca_cld/WCNSS_qcom_cfg.ini ] || [ ! -e /lib/firmware/a630_sqe.fw ]; } && [ -n "$VEND" ]; then
	mkdir -p /run/a70q-vendor && mount -o ro "$VEND" /run/a70q-vendor && {
		cp /run/a70q-vendor/firmware/wlan/qca_cld/* /lib/firmware/wlan/qca_cld/
		cp /run/a70q-vendor/firmware/a630_sqe.fw /run/a70q-vendor/firmware/a612_rgmu.bin /lib/firmware/
		umount /run/a70q-vendor; }
fi

/usr/libexec/a70q/qrtr-ns -f 1 >/var/log/qrtr-ns.log 2>&1 &
# wait until the name service answers (kernel memshare server 52 is always there);
# publishing before qrtr-ns is bound loses the NEW_SERVER packet silently
for i in $(seq 1 50); do /usr/libexec/a70q/qrtr-lookup 2>/dev/null | grep -qE "^ +52 " && break; sleep 0.2; done

start_services() {
	TQFTPSERV_FW_DIRS="$FW:$FWM" /usr/libexec/a70q/tqftpserv >>/var/log/tqftpserv.log 2>&1 &
	/usr/sbin/rmtfs -P -r -v >>/var/log/rmtfs.log 2>&1 &
	PD_MAPPER_JSON_DIRS="$FW:$FWM" /usr/libexec/a70q/pd-mapper >>/var/log/pd-mapper.log 2>&1 &
}
services_ok() {
	l=$(/usr/libexec/a70q/qrtr-lookup 2>/dev/null)
	for svc in 14 64 4096; do echo "$l" | grep -qE "^ +$svc " || return 1; done
}
start_services
for try in 1 2 3; do
	sleep 2
	services_ok && break
	log "services not registered (try $try), restarting them"
	pkill -x tqftpserv; pkill -x rmtfs; pkill -x pd-mapper; sleep 1
	start_services
done
services_ok && log "qrtr services: rmtfs(14) pd-mapper(64) tftp(4096) OK" || { log "ERROR: qrtr services missing"; exit 1; }

# boot modem: subsystem stays up while /dev/subsys_modem is held open
( exec 3</dev/subsys_modem; exec sleep 2147483647 ) &
echo $! > /run/a70q-subsys-modem.pid
log "modem requested"

# boot ADSP (audio DSP; the q6 ASoC card sm6150-idp-snd-card appears once APR is up)
for f in "$FW"/adsp*; do ln -sf "$f" /lib/firmware/; done
( exec 3</dev/subsys_adsp; exec sleep 2147483647 ) &
echo $! > /run/a70q-subsys-adsp.pid
log "adsp requested"

# --- WLAN: WCN3990 firmware waits for the board data file over QMI (cnss-daemon's job on
# Android; downstream icnss never sends it). Then start the built-in qcacld driver.
for i in $(seq 1 60); do
	WLFW=$(/usr/libexec/a70q/qrtr-lookup 2>/dev/null | awk '$1==69 {print $4, $5; exit}')
	[ -n "$WLFW" ] && break; sleep 1
done
[ -n "$WLFW" ] || { log "ERROR: WLFW service (69) never appeared"; exit 1; }
sleep 1   # let icnss finish msa/cap handshake first
/usr/libexec/a70q/a70q-bdf $WLFW "$FW/bdwlan.bin" || { log "ERROR: BDF download failed"; exit 1; }
for i in $(seq 1 20); do grep -q "WLAN FW is ready" /sys/kernel/debug/ipc_logging/icnss/log 2>/dev/null && break; sleep 0.5; done
{ echo 1 > /sys/kernel/boot_wlan/boot_wlan; } 2>/dev/null || true   # EINVAL if already started
for i in $(seq 1 30); do [ -e /dev/wlan ] && break; sleep 0.5; done
echo ON > /dev/wlan
for i in $(seq 1 120); do [ -e /sys/class/net/wlan0 ] && break; sleep 0.5; done   # takes ~20 s
[ -e /sys/class/net/wlan0 ] && log "wlan0 up ($(cat /sys/class/net/wlan0/address))" || log "ERROR: no wlan0"
# suspend with WiFi connected: without a WoWLAN config cfg80211 disconnects on suspend and the
# resulting event aborts it. With the "disconnect" trigger too the firmware woke the AP at once
# in our test (WLAN_CE_2), magic-packet only lets it sleep (ERRORS C51)
[ -e /sys/class/net/wlan0 ] && iw phy "$(cat /sys/class/net/wlan0/phy80211/name)" wowlan enable magic-packet

# --- connect to WiFi if the user configured wpa_supplicant (hashed psk via wpa_passphrase)
CONF=/etc/wpa_supplicant/wpa_supplicant.conf
if rc-update show default 2>/dev/null | grep -qE "^ *networkmanager "; then
	log "NetworkManager enabled: leaving wlan0 to it"
elif [ -e /sys/class/net/wlan0 ] && [ -s "$CONF" ]; then
	ip link set wlan0 up
	wpa_supplicant -B -D nl80211 -i wlan0 -c "$CONF" -P /run/wpa_supplicant.wlan0.pid
	udhcpc -b -i wlan0 -p /run/udhcpc.wlan0.pid -x hostname:"$(hostname)" >/dev/null 2>&1
	log "wpa_supplicant + udhcpc started on wlan0"
fi
