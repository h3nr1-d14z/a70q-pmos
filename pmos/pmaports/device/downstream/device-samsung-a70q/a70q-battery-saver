#!/bin/sh
# a70q-battery-saver: automatic power saving on low battery (called from sxmo_hook_battery.sh on every
# upower change; runs as the session user).
#   on  when discharging and <= 20 %; off when charging/full or >= 25 % (hysteresis)
#   saving: gold cluster (cpu6-7) capped at 1.2 GHz (from 2.0), panel brightness capped at 50 %
#           (a70q-autobrightness honours the cap), "eco" in the status bar
#   a70q-battery-saver [update]   evaluate now          a70q-battery-saver status   on|off
FLAG="${XDG_RUNTIME_DIR:-/tmp}/a70q-battery-saver"
P6=/sys/devices/system/cpu/cpufreq/policy6
BL=/sys/class/backlight/panel0-backlight
ON_BELOW=${A70Q_SAVER_ON:-20}; OFF_ABOVE=${A70Q_SAVER_OFF:-25}; GOLD_CAP=1209600; BRIGHT_CAP=50   # env: testing

[ "$1" = status ] && { [ -e "$FLAG" ] && echo on || echo off; exit 0; }
cap="$(cat /sys/class/power_supply/battery/capacity 2>/dev/null)"
st="$(cat /sys/class/power_supply/battery/status 2>/dev/null)"
[ -n "$cap" ] || exit 0

if [ ! -e "$FLAG" ] && [ "$st" = Discharging ] && [ "$cap" -le "$ON_BELOW" ]; then
	touch "$FLAG"
	echo "$GOLD_CAP" > "$P6/scaling_max_freq" 2>/dev/null
	max="$(cat "$BL/max_brightness")"; lim=$((max * BRIGHT_CAP / 100))
	[ "$(cat "$BL/brightness")" -gt "$lim" ] && echo "$lim" > "$BL/brightness"
	notify-send "Battery saver on" "Battery ${cap}%: big CPU cores capped at 1.2 GHz, brightness at ${BRIGHT_CAP}%"
elif [ -e "$FLAG" ] && { [ "$st" != Discharging ] || [ "$cap" -ge "$OFF_ABOVE" ]; }; then
	rm -f "$FLAG"
	cat "$P6/cpuinfo_max_freq" > "$P6/scaling_max_freq" 2>/dev/null
	notify-send --urgency=low "Battery saver off"
fi
exit 0
