# Mainline kernel for the Samsung Galaxy A70 (a70q), packaged from pmos/mainline (build.sh +
# mkboot-pmos.sh, see pmos/mainline/README.md): the modules plus the daily boot image, which the
# install script writes to the RECOVERY partition (BOOT keeps the downstream kernel; never put this
# image in BOOT, the bootloader applies the dtbo partition overlays there and hangs).
# Built with pmos/mainline/pack-apk.sh, which copies boot-mainline.img and modules.tar.gz here.
pkgname=linux-samsung-a70q-mainline
pkgver=7.3.4
pkgrel=1
pkgdesc="Samsung Galaxy A70 mainline kernel (RECOVERY partition, selected with a70q-boot-default)"
url="https://kernel.org"
arch="aarch64"
license="GPL-2.0-only"
options="!strip !check !tracedeps"
install="$pkgname.post-install $pkgname.post-upgrade"
source="boot-mainline.img modules.tar.gz"

package() {
	mkdir -p "$pkgdir"
	tar -xzf "$srcdir"/modules.tar.gz -C "$pkgdir"
	install -Dm644 "$srcdir"/boot-mainline.img "$pkgdir"/usr/share/a70q/mainline/boot-mainline.img
}

sha512sums="
