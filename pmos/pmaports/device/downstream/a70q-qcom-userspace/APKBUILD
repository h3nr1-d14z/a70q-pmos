# Qualcomm remote-processor userspace for a70q (SM6150, downstream 4.14 kernel).
# The downstream kernel has no in-kernel QRTR name service and no remoteproc
# class, so we build qrtr-ns from the last qrtr commit that still had it and
# patch pd-mapper/tqftpserv to find firmware without /sys/class/remoteproc.
# a70q-bdf replaces Android's proprietary cnss-daemon for the WCN3990 board data.
# a70q-btinit does the WCN3988 Bluetooth firmware download (btqca) and attaches HCI UART (H4).
maintainer="a70q pmOS port <noreply@example.org>"
pkgname=a70q-qcom-userspace
pkgver=1
pkgrel=2
pkgdesc="QRTR name service, pd-mapper, tqftpserv, WLAN BDF / Bluetooth loaders and reboot-mode for Galaxy A70"
url="https://github.com/linux-msm"
arch="aarch64"
license="BSD-3-Clause AND GPL-2.0-or-later"
makedepends="linux-headers xz-dev"
options="!check"
_qrtr=6d950d26e50d9ea3607510308fdd653bccc54400
_pdm=5ecd2fe926aca7abfe40724177f63b942cff3947
_tftp=b31de6db4f31d09119293203d39636b827f16321
source="
	qrtr-$_qrtr.tar.gz::https://github.com/linux-msm/qrtr/archive/$_qrtr.tar.gz
	pd-mapper-$_pdm.tar.gz::https://github.com/linux-msm/pd-mapper/archive/$_pdm.tar.gz
	tqftpserv-$_tftp.tar.gz::https://github.com/linux-msm/tqftpserv/archive/$_tftp.tar.gz
	qrtr-ns-0001-trust-configured-node.diff
	pd-mapper-0001-PD_MAPPER_JSON_DIRS.diff
	tqftpserv-0001-fallback-without-remoteproc.diff
	a70q-bdf.c
	a70q-btinit.c
	reboot-mode.c
"
builddir="$srcdir"

prepare() {
	default_prepare
	(cd qrtr-$_qrtr && patch -p1 < "$srcdir"/qrtr-ns-0001-trust-configured-node.diff)
	(cd pd-mapper-$_pdm && patch -p1 < "$srcdir"/pd-mapper-0001-PD_MAPPER_JSON_DIRS.diff)
	(cd tqftpserv-$_tftp && patch -p1 < "$srcdir"/tqftpserv-0001-fallback-without-remoteproc.diff)
}

build() {
	local q="$srcdir/qrtr-$_qrtr"
	mkdir -p out
	$CC $CFLAGS -I$q/include -I$q/lib -o out/qrtr-ns $q/src/ns.c $q/src/addr.c \
		$q/src/hash.c $q/src/map.c $q/src/util.c $q/src/waiter.c $q/lib/*.c $LDFLAGS
	$CC $CFLAGS -I$q/include -I$q/lib -o out/qrtr-lookup $q/src/lookup.c $q/src/util.c \
		$q/lib/*.c $LDFLAGS
	(cd pd-mapper-$_pdm && $CC $CFLAGS -I$q/include -o ../out/pd-mapper pd-mapper.c assoc.c \
		json.c lzma_decomp.c servreg_loc.c $q/lib/*.c $LDFLAGS -llzma)
	(cd tqftpserv-$_tftp && $CC $CFLAGS -I$q/include -o ../out/tqftpserv tqftpserv.c \
		translate.c $q/lib/*.c $LDFLAGS)
	$CC $CFLAGS -o out/a70q-bdf a70q-bdf.c $LDFLAGS
	$CC $CFLAGS -o out/a70q-btinit a70q-btinit.c $LDFLAGS
	$CC $CFLAGS -o out/reboot-mode reboot-mode.c $LDFLAGS
}

package() {
	local f
	for f in qrtr-ns qrtr-lookup pd-mapper tqftpserv a70q-bdf a70q-btinit reboot-mode; do
		install -Dm755 out/$f "$pkgdir"/usr/libexec/a70q/$f
	done
	install -d "$pkgdir"/usr/bin
	ln -s /usr/libexec/a70q/reboot-mode "$pkgdir"/usr/bin/reboot-mode
	ln -s /usr/libexec/a70q/qrtr-lookup "$pkgdir"/usr/bin/qrtr-lookup
}

