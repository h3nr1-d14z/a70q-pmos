CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_USB_CONFIGFS_ECM=y
# pmbootstrap kconfig check (category default)
CONFIG_NLS_ASCII=y
CONFIG_SYSVIPC=y
CONFIG_VT=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_USER_NS=y
# kernel log on the AMOLED panel
CONFIG_FRAMEBUFFER_CONSOLE=y
# Android ueventd firmware fallback: without it the kernel waits 60 s per missing firmware
# CONFIG_FW_LOADER_USER_HELPER_FALLBACK is not set
# Bluetooth: HCI over the WCN399x UART (H4), firmware loaded by a70q-btinit in userspace
CONFIG_BT_HCIUART=y
CONFIG_BT_HCIUART_H4=y
# Bluetooth profiles: RFCOMM (OBEX file transfer, HFP), BNEP (PAN), HIDP
CONFIG_BT_RFCOMM=y
# rfcomm/tty.c was removed by the vendor -> no RFCOMM TTY
# CONFIG_BT_RFCOMM_TTY is not set
CONFIG_BT_BNEP=y
CONFIG_BT_HIDP=y

# NFC: pn547 probe spins ~18 s on I2C timeouts at boot (no chip answers on SM-A705F), ERRORS C66
# CONFIG_NFC_PN547 is not set
# CONFIG_SEC_NFC_LOGGER is not set
