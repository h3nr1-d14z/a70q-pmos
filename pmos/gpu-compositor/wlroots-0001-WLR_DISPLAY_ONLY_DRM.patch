@@ -273,6 +274,11 @@
 		return VK_NULL_HANDLE;
 	}
 
+	// WLR_DISPLAY_ONLY_DRM: the DRM device only drives the display (e.g. Qualcomm SDE on
+	// downstream kernels) and the GPU is a non-DRM device (kgsl) without
+	// VK_EXT_physical_device_drm. Use the first non-CPU Vulkan device instead of failing.
+	bool display_only_drm = env_parse_bool("WLR_DISPLAY_ONLY_DRM");
+
 	struct stat drm_stat = {0};
 	if (drm_fd >= 0 && fstat(drm_fd, &drm_stat) != 0) {
 		wlr_log_errno(WLR_ERROR, "fstat failed");
@@ -347,6 +353,12 @@
 		bool found;
 		if (drm_fd >= 0) {
 			if (!has_drm_props) {
+				if (display_only_drm &&
+						phdev_props.deviceType != VK_PHYSICAL_DEVICE_TYPE_CPU) {
+					wlr_log(WLR_INFO, "WLR_DISPLAY_ONLY_DRM: using \"%s\" "
+						"without a DRM node", phdev_props.deviceName);
+					return phdev;
+				}
 				wlr_log(WLR_DEBUG, "  Ignoring physical device \"%s\": "
