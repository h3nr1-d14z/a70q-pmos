diff -ruN a/render/vulkan/renderer.c b/render/vulkan/renderer.c
--- a/render/vulkan/renderer.c	2026-11-14 12:38:17
+++ b/render/vulkan/renderer.c	2026-11-14 12:38:17
@@ -28,6 +28,7 @@
 #include "render/vulkan/shaders/output.frag.h"
 #include "types/wlr_buffer.h"
 #include "util/time.h"
+#include "util/env.h"
 
 // TODO:
 // - simplify stage allocation, don't track allocations but use ringbuffer-like
@@ -2617,7 +2618,12 @@
 
 	// Do not use the drm_fd that was passed in: we should prefer the render
 	// node even if a primary node was provided
-	dev->drm_fd = vulkan_open_phdev_drm_fd(phdev);
+	if (env_parse_bool("WLR_DISPLAY_ONLY_DRM") && drm_fd >= 0) {
+		// the GPU has no DRM node: buffers are allocated on the display device
+		dev->drm_fd = fcntl(drm_fd, F_DUPFD_CLOEXEC, 0);
+	} else {
+		dev->drm_fd = vulkan_open_phdev_drm_fd(phdev);
+	}
 
 	return vulkan_renderer_create_for_device(dev);
 
diff -ruN a/render/vulkan/vulkan.c b/render/vulkan/vulkan.c
--- a/render/vulkan/vulkan.c	2026-11-14 12:38:17
