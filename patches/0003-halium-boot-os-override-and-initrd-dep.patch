diff --git a/Android.mk b/Android.mk
index 8944080..a59f73e 100644
--- a/Android.mk
+++ b/Android.mk
@@ -75,9 +75,15 @@ ifneq "" "$(strip $(HALIUM_BOARD_KERNEL_CMDLINE) $(HALIUM_BOOTIMG_COMMANDLINE))"
   HALIUM_BOOTIMAGE_ARGS += --cmdline "$(strip $(HALIUM_BOARD_KERNEL_CMDLINE) $(HALIUM_BOOTIMG_COMMANDLINE))"
 endif
 
+# halium: anti-rollback Samsung sboot — header os_version + SPL phải >= floor ghi nhận
+# từ ROM cuối đã boot (PLATFORM_VERSION/PLATFORM_SECURITY_PATCH là readonly) →
+# override qua BOARD_BOOTIMG_OS_VERSION / BOARD_BOOTIMG_OS_PATCH_LEVEL
+HALIUM_OS_VERSION := $(if $(BOARD_BOOTIMG_OS_VERSION),$(BOARD_BOOTIMG_OS_VERSION),$(PLATFORM_VERSION))
+HALIUM_OS_PATCH_LEVEL := $(if $(BOARD_BOOTIMG_OS_PATCH_LEVEL),$(BOARD_BOOTIMG_OS_PATCH_LEVEL),$(PLATFORM_SECURITY_PATCH))
+
 HALIUM_BOOTIMAGE_ARGS += \
-    --os_version $(PLATFORM_VERSION) \
-    --os_patch_level $(PLATFORM_SECURITY_PATCH)
+    --os_version $(HALIUM_OS_VERSION) \
+    --os_patch_level $(HALIUM_OS_PATCH_LEVEL)
 
 include $(CLEAR_VARS)
 LOCAL_MODULE:= halium-boot
@@ -94,6 +100,13 @@ HALIUM_BOOT_INTERMEDIATE := $(call intermediates-dir-for,ROOT,$(LOCAL_MODULE),)
 HALIUM_BOOT_RAMDISK := $(HALIUM_BOOT_INTERMEDIATE)/halium-initramfs.gz
 GET_INITRD := $(LOCAL_PATH)/get-initrd.sh
 
+# halium: theo dõi source initramfs trong device tree — nếu không có dep này thì
+# intermediate stale và mọi patch initramfs đều bị bỏ qua khi package lại
+HALIUM_LOCAL_INITRD := $(sort $(wildcard device/*/$(TARGET_DEVICE)/initramfs.gz))
+ifeq ($(BOARD_USE_LOCAL_INITRD),true)
+$(HALIUM_BOOT_RAMDISK): $(HALIUM_LOCAL_INITRD)
+endif
+
 $(LOCAL_BUILT_MODULE): $(INSTALLED_KERNEL_TARGET) $(HALIUM_BOOT_RAMDISK) $(BOOTIMAGE_EXTRA_DEPS)
 	@echo "Making halium-boot.img in $(dir $@) using $(INSTALLED_KERNEL_TARGET) $(HALIUM_BOOT_RAMDISK)"
 	@mkdir -p $(dir $@)
